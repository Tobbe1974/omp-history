@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @{
        var pathBase = HttpContextAccessor.HttpContext?.Request.PathBase.Value?.TrimEnd('/') ?? "";
    }
    <base href="@(pathBase)/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["lib/bootstrap/dist/css/bootstrap.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/katex/katex.min.css"]" />
    <link rel="stylesheet" href="@Assets["lib/diff2html/diff2html.min.css"]" />
    <link rel="stylesheet" href="@Assets["app.css"]" />
    <link rel="stylesheet" href="@Assets["OmpHistory.styles.css"]" />
    <ImportMap />
    <link rel="icon" type="image/png" href="favicon.png" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <ReconnectModal />
    <script src="@Assets["lib/mermaid.min.js"]"></script>
    <script src="@Assets["lib/katex/katex.min.js"]"></script>
    <script src="@Assets["lib/katex/auto-render.min.js"]"></script>
    <script src="@Assets["lib/diff2html/diff2html.min.js"]"></script>
    <script>
        window.ompHistoryRenderMermaid = async function () {
            if (!window.mermaid) return;
            if (!window.__ompMermaidInitialized) {
                window.mermaid.initialize({
                    startOnLoad: false,
                    theme: 'dark',
                    securityLevel: 'loose'
                });
                window.__ompMermaidInitialized = true;
            }

            const blocks = document.querySelectorAll('.markdown-body pre.mermaid, .markdown-body pre > code.language-mermaid, .markdown-body div.mermaid');
            const nodesToRender = [];

            blocks.forEach((el) => {
                if (el.tagName.toLowerCase() === 'code') {
                    const pre = el.parentElement;
                    if (!pre) return;
                    const container = document.createElement('div');
                    container.className = 'mermaid-diagram';
                    container.textContent = el.textContent || '';
                    pre.replaceWith(container);
                    nodesToRender.push(container);
                } else if (el.tagName.toLowerCase() === 'pre') {
                    const container = document.createElement('div');
                    container.className = 'mermaid-diagram';
                    container.textContent = el.textContent || '';
                    el.replaceWith(container);
                    nodesToRender.push(container);
                } else if (!el.getAttribute('data-processed')) {
                    el.classList.add('mermaid-diagram');
                    nodesToRender.push(el);
                }
            });

            if (nodesToRender.length > 0) {
                try {
                    await window.mermaid.run({ nodes: nodesToRender });
                } catch (err) {
                    console.error('Mermaid render error:', err);
                }
            }

            const mdBody = document.querySelector('.markdown-body');
            if (mdBody && window.renderMathInElement) {
                try {
                    window.renderMathInElement(mdBody, {
                        delimiters: [
                            { left: '$$', right: '$$', display: true },
                            { left: '\\[', right: '\\]', display: true },
                            { left: '$', right: '$', display: false },
                            { left: '\\(', right: '\\)', display: false }
                        ],
                        throwOnError: false
                    });
                } catch (err) {
                    console.error('KaTeX render error:', err);
                }
            }

            if (window.Diff2Html) {
                const diffBlocks = document.querySelectorAll('.markdown-body pre > code.language-diff, .markdown-body pre > code.language-patch');
                diffBlocks.forEach((codeEl) => {
                    const pre = codeEl.parentElement;
                    if (!pre || pre.getAttribute('data-diff-rendered')) return;
                    const raw = codeEl.textContent || '';
                    if (!raw.includes('@@') && !raw.includes('diff --git') && !raw.includes('--- ')) return;
                    try {
                        const html = window.Diff2Html.html(raw, {
                            drawFileList: false,
                            matching: 'lines',
                            outputFormat: 'line-by-line',
                            colorScheme: 'dark'
                        });
                        const wrapper = document.createElement('div');
                        wrapper.className = 'omp-diff2html-wrapper omp-markdown-diff';
                        wrapper.innerHTML = html;
                        pre.replaceWith(wrapper);
                    } catch (err) {
                        console.error('Markdown diff2html render error:', err);
                    }
                });
            }
        };

        window.ompHistoryCaptureSelection = function () {
            const sel = window.getSelection();
            const text = sel ? sel.toString().trim() : '';
            let locationContext = '';

            try {
                if (sel && sel.rangeCount > 0) {
                    const range = sel.getRangeAt(0);
                    const startEl = range.startContainer.nodeType === Node.ELEMENT_NODE
                        ? range.startContainer
                        : range.startContainer.parentElement;
                    const endEl = range.endContainer.nodeType === Node.ELEMENT_NODE
                        ? range.endContainer
                        : range.endContainer.parentElement;

                    if (startEl) {
                        // 1. Check if selection is inside a diff2html file block
                        const d2hWrapper = startEl.closest('.d2h-file-wrapper');
                        if (d2hWrapper) {
                            const fileNameEl = d2hWrapper.querySelector('.d2h-file-name');
                            const fileName = fileNameEl ? fileNameEl.textContent.trim() : 'Diff';

                            const extractLineNum = (el) => {
                                if (!el) return null;
                                const tr = el.closest('tr');
                                if (!tr) return null;
                                const num2 = tr.querySelector('.line-num2');
                                const num1 = tr.querySelector('.line-num1');
                                const sideTd = el.closest('td');
                                if (num2 && num2.textContent.trim()) return num2.textContent.trim();
                                if (num1 && num1.textContent.trim()) return num1.textContent.trim() + ' (old)';
                                const lineTd = tr.querySelector('.d2h-code-linenumber, .d2h-code-side-linenumber');
                                if (lineTd) {
                                    const nums = lineTd.textContent.trim().split(/\s+/).filter(Boolean);
                                    if (nums.length > 0) return nums[nums.length - 1];
                                }
                                if (sideTd && sideTd.previousElementSibling && sideTd.previousElementSibling.classList.contains('d2h-code-side-linenumber')) {
                                    const n = sideTd.previousElementSibling.textContent.trim();
                                    if (n) return n;
                                }
                                return null;
                            };

                            const startLine = extractLineNum(startEl);
                            const endLine = extractLineNum(endEl);
                            if (startLine && endLine && startLine !== endLine) {
                                locationContext = `File: ${fileName} (lines ${startLine}–${endLine})`;
                            } else if (startLine) {
                                locationContext = `File: ${fileName} (line ${startLine})`;
                            } else {
                                locationContext = `File: ${fileName}`;
                            }
                        }
                        // 2. Check if selection is inside user prompt box
                        else if (startEl.closest('.prompt-section')) {
                            locationContext = 'User Prompt';
                        }
                        // 3. Check if selection is inside Markdown response
                        else {
                            const mdBody = startEl.closest('.markdown-body');
                            if (mdBody && text) {
                                const parts = [];

                                // Find nearest preceding heading (h1-h6)
                                const headings = Array.from(mdBody.querySelectorAll('h1, h2, h3, h4, h5, h6'));
                                let currentHeading = null;
                                for (const h of headings) {
                                    const cmp = range.comparePoint(h, 0);
                                    if (cmp >= 0 || h.contains(startEl)) {
                                        currentHeading = h.textContent.trim();
                                    } else {
                                        break;
                                    }
                                }
                                if (currentHeading) {
                                    parts.push(`Section "${currentHeading}"`);
                                }

                                // Check if inside a fenced code block <pre><code>
                                const preEl = startEl.closest('pre');
                                if (preEl && mdBody.contains(preEl)) {
                                    const codeEl = preEl.querySelector('code');
                                    let lang = '';
                                    if (codeEl && codeEl.className) {
                                        const m = codeEl.className.match(/language-([\w-]+)/);
                                        if (m) lang = m[1];
                                    }
                                    try {
                                        const preRange = document.createRange();
                                        preRange.selectNodeContents(preEl);
                                        preRange.setEnd(range.startContainer, range.startOffset);
                                        const prefixText = preRange.toString();
                                        const startLine = prefixText.split('\n').length;
                                        const selectedLines = text.split('\n').length;
                                        const endLine = startLine + selectedLines - 1;
                                        const codeLabel = lang ? `Code block (${lang})` : 'Code block';
                                        if (endLine > startLine) {
                                            parts.push(`${codeLabel} lines ${startLine}–${endLine}`);
                                        } else {
                                            parts.push(`${codeLabel} line ${startLine}`);
                                        }
                                    } catch {
                                        parts.push(lang ? `Code block (${lang})` : 'Code block');
                                    }
                                } else {
                                    // Compute line number and occurrence index within the response text
                                    try {
                                        const fullText = mdBody.innerText || mdBody.textContent || '';
                                        const prefixRange = document.createRange();
                                        prefixRange.selectNodeContents(mdBody);
                                        prefixRange.setEnd(range.startContainer, range.startOffset);
                                        const beforeText = prefixRange.toString();
                                        const approxLine = beforeText.split('\n').length;
                                        if (approxLine > 0) {
                                            parts.push(`line ~${approxLine}`);
                                        }

                                        if (text.length >= 2 && text.length <= 200 && fullText) {
                                            let totalMatches = 0;
                                            let idx = 0;
                                            while ((idx = fullText.indexOf(text, idx)) !== -1) {
                                                totalMatches++;
                                                idx += text.length;
                                            }
                                            if (totalMatches > 1) {
                                                let priorMatches = 0;
                                                let pIdx = 0;
                                                while ((pIdx = beforeText.indexOf(text, pIdx)) !== -1) {
                                                    priorMatches++;
                                                    pIdx += text.length;
                                                }
                                                const occNum = Math.min(priorMatches + 1, totalMatches);
                                                parts.push(`occurrence ${occNum} of ${totalMatches}`);
                                            }
                                        }
                                    } catch {
                                        // ignore range offset errors
                                    }
                                }

                                if (parts.length > 0) {
                                    locationContext = parts.join(', ');
                                }
                            }
                        }
                    }
                }
            } catch (err) {
                console.warn('Selection context capture error:', err);
            }

            setTimeout(() => {
                const textarea = document.getElementById('word-comment-textarea');
                if (textarea) {
                    textarea.value = '';
                    textarea.focus();
                    if (!textarea._ompKeyGuardAttached) {
                        textarea._ompKeyGuardAttached = true;
                        textarea.addEventListener('keydown', (ev) => {
                            if (ev.key === 'Enter' && (ev.altKey || ev.ctrlKey || ev.metaKey)) {
                                ev.preventDefault();
                            }
                        });
                    }
                }
            }, 50);
            return { text: text, locationContext: locationContext };
        };

        window.ompHistoryRenderGitDiff = function (elementId, rawDiff, outputFormat, drawFileList) {
            const container = document.getElementById(elementId);
            if (!container) return;
            if (!rawDiff || !rawDiff.trim()) {
                container.innerHTML = '';
                return;
            }
            if (!window.Diff2Html) {
                container.textContent = rawDiff;
                return;
            }
            try {
                const html = window.Diff2Html.html(rawDiff, {
                    drawFileList: drawFileList !== false,
                    matching: 'lines',
                    outputFormat: outputFormat === 'side-by-side' ? 'side-by-side' : 'line-by-line',
                    colorScheme: 'dark'
                });
                container.innerHTML = html;
            } catch (err) {
                console.error('Diff2Html render error:', err);
                container.textContent = rawDiff;
            }
        };
    </script>
    <script src="@Assets["_framework/blazor.web.js"]"></script>
</body>

</html>
