@inject ActiveSessionTracker SessionTracker

<aside class="pane sessions-pane" aria-label="Sessions">
    <div class="pane-header pane-tabs-header">
        <div class="pane-tabs" role="tablist" aria-label="Sessions and Suggestions">
            <button type="button"
                    role="tab"
                    aria-selected="@(LeftPaneTab == "sessions" ? "true" : "false")"
                    class="pane-tab @(LeftPaneTab == "sessions" ? "active" : "")"
                    @onclick='() => OnSetLeftPaneTab.InvokeAsync("sessions")'>
                SESSIONS @(string.IsNullOrEmpty(SelectedRepo) ? "" : $"({Sessions.Count})")
            </button>
            <button type="button"
                    role="tab"
                    aria-selected="@(LeftPaneTab == "suggestions" ? "true" : "false")"
                    class="pane-tab @(LeftPaneTab == "suggestions" ? "active" : "")"
                    @onclick='() => OnSetLeftPaneTab.InvokeAsync("suggestions")'>
                SUGGESTIONS @(string.IsNullOrEmpty(SelectedRepo) ? "" : $"({Suggestions.Count})")
            </button>
        </div>
    </div>
    <div class="pane-body">
        @if (LeftPaneTab == "suggestions")
        {
            @if (string.IsNullOrEmpty(SelectedRepo))
            {
                <div class="empty-state">Select a repository to view suggestions.</div>
            }
            else if (Suggestions.Count == 0)
            {
                <div class="empty-state">No suggestions recorded for <strong>@SelectedRepo</strong> yet.</div>
            }
            else
            {
                @foreach (var sug in Suggestions)
                {
                    var isSelected = SelectedSuggestionId == sug.Id;
                    <div class="list-card session-card suggestion-card @(isSelected ? "selected" : "") @(sug.Status == "sent" ? "suggestion-sent" : "")"
                         @onclick="() => OnSelectSuggestion.InvokeAsync(sug.Id)"
                         @oncontextmenu="(e) => OnOpenSuggestionContextMenu.InvokeAsync((e, sug))"
                         @oncontextmenu:preventDefault="true">
                        <div class="session-card-main">
                            <div class="session-title-row">
                                <div class="session-title" title="@sug.Title">@sug.Title</div>
                                @if (!string.IsNullOrWhiteSpace(sug.Severity))
                                {
                                    <span class="suggestion-severity-badge severity-@sug.Severity">@sug.Severity.ToUpperInvariant()</span>
                                }
                                <span class="suggestion-status-badge status-@sug.Status">@sug.Status.ToUpperInvariant()</span>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(sug.FilePaths))
                            {
                                <div class="session-id suggestion-files" title="@sug.FilePaths">@sug.FilePaths</div>
                            }
                            <div class="session-meta">
                                <span>#@sug.Id</span>
                                <span>•</span>
                                <span title="@sug.CreatedAt">@FormatFullDateTime(sug.CreatedAt)</span>
                            </div>
                        </div>
                        <button type="button"
                                class="delete-session-btn"
                                title="Remove suggestion"
                                aria-label="Remove suggestion @sug.Title"
                                @onclick:stopPropagation="true"
                                @onclick="() => OnRequestDeleteSuggestion.InvokeAsync(sug)">
                            ×
                        </button>
                    </div>
                }
            }
        }
        else if (string.IsNullOrEmpty(SelectedRepo))
        {
            <div class="empty-state">Select or create a session from OMP to begin.</div>
        }
        else if (Sessions.Count == 0)
        {
            <div class="empty-state">No sessions in <strong>@SelectedRepo</strong>.</div>
        }
        else
        {
            @foreach (var session in Sessions)
            {
                var isSelected = string.Equals(session.SessionId, SelectedSessionId, StringComparison.Ordinal);
                var isActiveSession = SessionTracker.IsSessionActive(session.SessionId);
                <div class="list-card session-card @(isSelected ? "selected" : "") @(isActiveSession ? "active-omp-session" : "")"
                     @onclick="() => OnSelectSession.InvokeAsync(session.SessionId)"
                     @oncontextmenu="(e) => OnSessionContextMenu.InvokeAsync((e, session))"
                     @oncontextmenu:preventDefault="true">
                    <div class="session-card-main">
                        <div class="session-title-row">
                            <div class="session-title" title="@session.Name">@session.Name</div>
                            @if (isActiveSession)
                            {
                                <span class="session-active-badge" title="Active in OMP terminal">
                                    <span class="session-active-dot"></span>
                                    ACTIVE
                                </span>
                            }
                        </div>
                        <div class="session-id" title="@session.SessionId">@session.SessionId</div>
                        <div class="session-meta">
                            <span>@session.ConversationCount @(session.ConversationCount == 1 ? "turn" : "turns")</span>
                            <span>•</span>
                            <span class="usage-meta-pill @(session.TotalCredits.HasValue ? "" : "usage-na")"
                                  title="@FormatUsageTooltip(session.TotalCredits, session.TotalCostUsd, session.TotalTokens)">
                                Cr: @FormatCredits(session.TotalCredits)
                            </span>
                            <span>•</span>
                            <span title="@session.UpdatedAt">@FormatFullDateTime(session.UpdatedAt)</span>
                        </div>
                    </div>
                    <button type="button"
                            class="delete-session-btn"
                            title="Delete session"
                            aria-label="Delete session @session.Name"
                            @onclick:stopPropagation="true"
                            @onclick="() => OnRequestDeleteSession.InvokeAsync(session)">
                        ×
                    </button>
                </div>
            }
        }
    </div>
    <div class="sessions-footer">
        @if (IsSettingsOpen)
        {
            <div class="settings-popover" role="dialog" aria-label="Settings">
                <div class="settings-popover-header">
                    <span>Global Settings</span>
                    <button type="button"
                            class="settings-popover-close"
                            aria-label="Close settings"
                            @onclick="OnToggleSettings">×</button>
                </div>
                <label class="settings-checkbox-row">
                    <input type="checkbox"
                           checked="@AutoSelectNewConversation"
                           @onchange="OnAutoSelectChanged" />
                    <span>Auto-select new conversations</span>
                </label>
                <label class="settings-checkbox-row">
                    <input type="checkbox"
                           checked="@AskBeforeDeleteSession"
                           @onchange="OnAskBeforeDeleteSessionChanged" />
                    <span>Ask before delete (Sessions)</span>
                </label>
                <label class="settings-checkbox-row">
                    <input type="checkbox"
                           checked="@AskBeforeDeleteSuggestion"
                           @onchange="OnAskBeforeDeleteSuggestionChanged" />
                    <span>Ask before delete (Suggestions)</span>
                </label>
                <label class="settings-checkbox-row">
                    <input type="checkbox"
                           checked="@NtfyEnabled"
                           @onchange="OnNtfyEnabledChanged" />
                    <span>Send replies to ntfy</span>
                </label>
                <div class="settings-ntfy-fields">
                    <div class="settings-field-group">
                        <label class="settings-field-label" for="ntfy-server-input">ntfy Server URL</label>
                        <input id="ntfy-server-input"
                               type="text"
                               class="settings-text-input"
                               placeholder="https://skegriebyavag13.duckdns.org"
                               value="@NtfyServerUrl"
                               @onchange="OnNtfyServerUrlChanged" />
                    </div>
                    <div class="settings-field-group">
                        <label class="settings-field-label" for="ntfy-topic-input">ntfy Topic</label>
                        <input id="ntfy-topic-input"
                               type="text"
                               class="settings-text-input"
                               placeholder="omp-history"
                               value="@NtfyTopic"
                               @onchange="OnNtfyTopicChanged" />
                    </div>
                    @if (!string.IsNullOrWhiteSpace(NtfyStatusMessage))
                    {
                        <span class="settings-ntfy-status">@NtfyStatusMessage</span>
                    }
                </div>
            </div>
        }
        <button type="button"
                class="settings-cog-btn @(IsSettingsOpen ? "active" : "")"
                title="Settings"
                aria-label="Settings"
                @onclick="OnToggleSettings">
            <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="10" cy="10" r="2.6" />
                <path d="M16.2 12.3a1.3 1.3 0 0 0 .26 1.43l.05.05a1.55 1.55 0 1 1-2.2 2.2l-.05-.05a1.3 1.3 0 0 0-1.43-.26 1.3 1.3 0 0 0-.78 1.19v.14a1.55 1.55 0 1 1-3.1 0v-.07a1.3 1.3 0 0 0-.84-1.19 1.3 1.3 0 0 0-1.43.26l-.05.05a1.55 1.55 0 1 1-2.2-2.2l.05-.05a1.3 1.3 0 0 0 .26-1.43 1.3 1.3 0 0 0-1.19-.78h-.14a1.55 1.55 0 1 1 0-3.1h.07a1.3 1.3 0 0 0 1.19-.84 1.3 1.3 0 0 0-.26-1.43l-.05-.05a1.55 1.55 0 1 1 2.2-2.2l.05.05a1.3 1.3 0 0 0 1.43.26h.06a1.3 1.3 0 0 0 .78-1.19v-.14a1.55 1.55 0 1 1 3.1 0v.07a1.3 1.3 0 0 0 .78 1.19 1.3 1.3 0 0 0 1.43-.26l.05-.05a1.55 1.55 0 1 1 2.2 2.2l-.05.05a1.3 1.3 0 0 0-.26 1.43v.06a1.3 1.3 0 0 0 1.19.78h.14a1.55 1.55 0 1 1 0 3.1h-.07a1.3 1.3 0 0 0-1.19.78z" />
            </svg>
            <span class="settings-cog-label">Settings</span>
        </button>
    </div>
</aside>

@code {
    [Parameter]
    public string? SelectedRepo { get; set; }

    [Parameter]
    public string LeftPaneTab { get; set; } = "sessions";

    [Parameter, EditorRequired]
    public IReadOnlyList<SessionRecord> Sessions { get; set; } = [];

    [Parameter]
    public string? SelectedSessionId { get; set; }

    [Parameter, EditorRequired]
    public IReadOnlyList<SuggestionRecord> Suggestions { get; set; } = [];

    [Parameter]
    public long? SelectedSuggestionId { get; set; }

    [Parameter]
    public bool IsSettingsOpen { get; set; }

    [Parameter]
    public bool AutoSelectNewConversation { get; set; }

    [Parameter]
    public bool AskBeforeDeleteSession { get; set; }

    [Parameter]
    public bool AskBeforeDeleteSuggestion { get; set; }

    [Parameter]
    public bool NtfyEnabled { get; set; }

    [Parameter]
    public string NtfyServerUrl { get; set; } = string.Empty;

    [Parameter]
    public string NtfyTopic { get; set; } = string.Empty;

    [Parameter]
    public string? NtfyStatusMessage { get; set; }

    [Parameter]
    public EventCallback<string> OnSetLeftPaneTab { get; set; }

    [Parameter]
    public EventCallback<string> OnSelectSession { get; set; }

    [Parameter]
    public EventCallback<(MouseEventArgs Args, SessionRecord Session)> OnSessionContextMenu { get; set; }

    [Parameter]
    public EventCallback<SessionRecord> OnRequestDeleteSession { get; set; }

    [Parameter]
    public EventCallback<long> OnSelectSuggestion { get; set; }

    [Parameter]
    public EventCallback<(MouseEventArgs Args, SuggestionRecord Suggestion)> OnOpenSuggestionContextMenu { get; set; }

    [Parameter]
    public EventCallback<SuggestionRecord> OnRequestDeleteSuggestion { get; set; }

    [Parameter]
    public EventCallback OnToggleSettings { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnAutoSelectChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnAskBeforeDeleteSessionChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnAskBeforeDeleteSuggestionChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnNtfyEnabledChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnNtfyServerUrlChanged { get; set; }

    [Parameter]
    public EventCallback<ChangeEventArgs> OnNtfyTopicChanged { get; set; }
}
