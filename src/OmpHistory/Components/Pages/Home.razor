    private void SendSuggestionChange(SuggestionRecord sug)
    {
        var targetSessionId = !string.IsNullOrWhiteSpace(_selectedSessionId) && IsSelectedSessionActive
            ? _selectedSessionId
            : (ActiveSessionInRepo?.SessionId ?? sug.SessionId ?? _selectedSessionId ?? _sessions.FirstOrDefault()?.SessionId);

        if (string.IsNullOrWhiteSpace(targetSessionId))
        {
            _suggestionStatusMessage = "No session available for this repository";
            return;
        }

        var isActive = SessionTracker.IsSessionActive(targetSessionId);
        SessionTracker.EnqueueSuggestionChange(targetSessionId, sug);
        Repository.UpdateSuggestionStatus(sug.Id, "sent");
        _suggestionStatusMessage = isActive
            ? "Change suggestion sent to active OMP session"
            : "Change suggestion queued (will deliver when session becomes active)";
    }
    private void CancelDeleteSession()
    {
        _sessionToDelete = null;
    }

    private void ConfirmDeleteSession()
    {
        if (_sessionToDelete is null)
        {
            return;
        }

        var sessionId = _sessionToDelete.SessionId;
        _sessionToDelete = null;

        var wasSelected = string.Equals(_selectedSessionId, sessionId, StringComparison.Ordinal);
        if (wasSelected)
        {
            _selectedSessionId = null;
            _selectedConversationId = null;
        }
        Repository.DeleteSession(sessionId);
    }

    private string GetCachedConversationHtml(ConversationRecord conv)
    {
        if (_cachedMdConversationId == conv.Id && string.Equals(_cachedMdConversationSource, conv.ResponseMd, StringComparison.Ordinal))
        {
            return _cachedMdConversationHtml;
        }
        _cachedMdConversationId = conv.Id;
        _cachedMdConversationSource = conv.ResponseMd;
        _cachedMdConversationHtml = RenderMarkdown(conv.ResponseMd);
        return _cachedMdConversationHtml;
    }

    private string GetCachedSuggestionHumanHtml(SuggestionRecord sug)
    {
        if (_cachedMdSuggestionId == sug.Id && string.Equals(_cachedMdSuggestionHumanSource, sug.HumanSummary, StringComparison.Ordinal))
        {
            return _cachedMdSuggestionHumanHtml;
        }
        if (_cachedMdSuggestionId != sug.Id)
        {
            _cachedMdSuggestionId = sug.Id;
            _cachedMdSuggestionAgentSource = null;
        }
        _cachedMdSuggestionHumanSource = sug.HumanSummary;
        _cachedMdSuggestionHumanHtml = RenderMarkdown(sug.HumanSummary);
        return _cachedMdSuggestionHumanHtml;
    }

    private string GetCachedSuggestionAgentHtml(SuggestionRecord sug)
    {
        if (_cachedMdSuggestionId == sug.Id && string.Equals(_cachedMdSuggestionAgentSource, sug.AgentContext, StringComparison.Ordinal))
        {
            return _cachedMdSuggestionAgentHtml;
        }
        if (_cachedMdSuggestionId != sug.Id)
        {
            _cachedMdSuggestionId = sug.Id;
            _cachedMdSuggestionHumanSource = null;
        }
        _cachedMdSuggestionAgentSource = sug.AgentContext;
        _cachedMdSuggestionAgentHtml = RenderMarkdown(sug.AgentContext);
        return _cachedMdSuggestionAgentHtml;
    }

