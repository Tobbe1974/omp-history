@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Markdig
@inject HistoryRepository Repository
@inject HistoryNotifier Notifier
@inject IJSRuntime JS

<PageTitle>OMP History</PageTitle>

<div class="history-app">
    <header class="history-header">
        <div class="brand">
            <span class="brand-dot"></span>
            <span class="brand-title">OMP History</span>
        </div>

        <div class="repo-selector">
            <span class="repo-label">REPO</span>
            @if (_repos.Count == 0)
            {
                <span class="repo-empty">No repositories recorded yet</span>
            }
            else
            {
                <div class="repo-pills" role="tablist" aria-label="Repositories">
                    @foreach (var repo in _repos)
                    {
                        var isSelected = string.Equals(repo.Repo, _selectedRepo, StringComparison.Ordinal);
                        <button type="button"
                                class="repo-pill @(isSelected ? "active" : "")"
                                @onclick="() => SelectRepo(repo.Repo)">
                            <span class="repo-name">@repo.Repo</span>
                            <span class="repo-count">@repo.SessionCount</span>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="header-actions">
            <button type="button"
                    class="pin-panes-btn @(_isPanesPinned ? "active" : "")"
                    title="@(_isPanesPinned ? "Unpin to hide Sessions and Conversations" : "Pin to show Sessions and Conversations")"
                    aria-label="Pin Sessions and Conversations panes"
                    aria-pressed="@(_isPanesPinned ? "true" : "false")"
                    @onclick="TogglePanesPinned">
                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9.5 2.5L13.5 6.5L12 8L9.5 7.5L6.5 10.5L7 13L5.5 14.5L3 12L1.5 14.5L3.5 12.5L1.5 10.5L3 9L5.5 9.5L8.5 6.5L8 4L9.5 2.5Z" />
                </svg>
                <span>Pin Lists</span>
            </button>

            <div class="header-status">
                <span class="live-indicator"></span>
                <span>Live</span>
            </div>
        </div>
    </header>

    <div class="history-workspace @(_isPanesPinned ? "" : "panes-unpinned")">
        @if (_isPanesPinned)
        {
        <aside class="pane sessions-pane" aria-label="Sessions">
            <div class="pane-header">
                <span>SESSIONS @(string.IsNullOrEmpty(_selectedRepo) ? "" : $"({_sessions.Count})")</span>
            </div>

            <div class="pane-body">
                @if (string.IsNullOrEmpty(_selectedRepo))
                {
                    <div class="empty-state">Select or create a session from OMP to begin.</div>
                }
                else if (_sessions.Count == 0)
                {
                    <div class="empty-state">No sessions in <strong>@_selectedRepo</strong>.</div>
                }
                else
                {
                    @foreach (var session in _sessions)
                    {
                        var isSelected = string.Equals(session.SessionId, _selectedSessionId, StringComparison.Ordinal);
                        <div class="list-card session-card @(isSelected ? "selected" : "")"
                             @onclick="() => SelectSession(session.SessionId)">
                            <div class="session-card-main">
                                <div class="session-title" title="@session.Name">@session.Name</div>
                                <div class="session-id" title="@session.SessionId">@session.SessionId</div>
                                <div class="session-meta">
                                    <span>@session.ConversationCount @(session.ConversationCount == 1 ? "turn" : "turns")</span>
                                    <span>•</span>
                                    <span title="@session.UpdatedAt">@FormatFullDateTime(session.UpdatedAt)</span>
                                </div>
                            </div>
                            <button type="button"
                                    class="delete-session-btn"
                                    title="Delete session"
                                    aria-label="Delete session @session.Name"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => RequestDeleteSession(session)">
                                ×
                            </button>
                        </div>
                    }
                }
            </div>

            <div class="sessions-footer">
                @if (_isSettingsOpen)
                {
                    <div class="settings-popover" role="dialog" aria-label="Settings">
                        <div class="settings-popover-header">
                            <span>Settings</span>
                            <button type="button"
                                    class="settings-popover-close"
                                    aria-label="Close settings"
                                    @onclick="ToggleSettings">×</button>
                        </div>
                        <label class="settings-checkbox-row">
                            <input type="checkbox" @bind="_autoSelectNewConversation" />
                            <span>Auto-select new conversations</span>
                        </label>
                    </div>
                }

                <button type="button"
                        class="settings-cog-btn @(_isSettingsOpen ? "active" : "")"
                        title="Settings"
                        aria-label="Settings"
                        @onclick="ToggleSettings">
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="10" cy="10" r="2.6" />
                        <path d="M16.2 12.3a1.3 1.3 0 0 0 .26 1.43l.05.05a1.55 1.55 0 1 1-2.2 2.2l-.05-.05a1.3 1.3 0 0 0-1.43-.26 1.3 1.3 0 0 0-.78 1.19v.14a1.55 1.55 0 1 1-3.1 0v-.07a1.3 1.3 0 0 0-.84-1.19 1.3 1.3 0 0 0-1.43.26l-.05.05a1.55 1.55 0 1 1-2.2-2.2l.05-.05a1.3 1.3 0 0 0 .26-1.43 1.3 1.3 0 0 0-1.19-.78h-.14a1.55 1.55 0 1 1 0-3.1h.07a1.3 1.3 0 0 0 1.19-.84 1.3 1.3 0 0 0-.26-1.43l-.05-.05a1.55 1.55 0 1 1 2.2-2.2l.05.05a1.3 1.3 0 0 0 1.43.26h.06a1.3 1.3 0 0 0 .78-1.19v-.14a1.55 1.55 0 1 1 3.1 0v.07a1.3 1.3 0 0 0 .78 1.19 1.3 1.3 0 0 0 1.43-.26l.05-.05a1.55 1.55 0 1 1 2.2 2.2l-.05.05a1.3 1.3 0 0 0-.26 1.43v.06a1.3 1.3 0 0 0 1.19.78h.14a1.55 1.55 0 1 1 0 3.1h-.07a1.3 1.3 0 0 0-1.19.78z" />
                    </svg>
                    <span class="settings-cog-label">Settings</span>
                </button>
            </div>
        </aside>

        <!-- Pane 2: Conversations in selected session -->
        <section class="pane conversations-pane" aria-label="Conversations">
            <div class="pane-header">
                <span>
                    CONVERSATIONS
                    @if (_conversations.Count > 0)
                    {
                        if (HasActiveFilter)
                        {
                            <span>(@FilteredConversations.Count / @_conversations.Count)</span>
                        }
                        else
                        {
                            <span>(@_conversations.Count)</span>
                        }
                    }
                </span>

                <div class="pane-header-actions">
                    @if (HasActiveFilter)
                    {
                        <span class="active-filter-chip" title="Filtered by: @_appliedFilter">@_appliedFilter</span>
                        <button type="button"
                                class="funnel-btn clear-funnel-btn"
                                title="Remove filter"
                                aria-label="Remove conversation filter"
                                @onclick="ClearFilter">
                            <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2.5 3.5h13l-5 6v5l-3 1.5v-6.5l-5-6z" />
                                <path d="M14.5 12.5l4 4m0-4l-4 4" stroke-width="2" />
                            </svg>
                        </button>
                    }
                    <button type="button"
                            class="funnel-btn @(HasActiveFilter || _isFilterModalOpen ? "active" : "")"
                            title="Filter conversations"
                            aria-label="Filter conversations"
                            @onclick="OpenFilterModal">
                        <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2.5 3.5h15l-6 6.5v5.5l-3 1.5v-7l-6-6.5z" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="pane-body">
                @if (string.IsNullOrEmpty(_selectedSessionId))
                {
                    <div class="empty-state">Select a session to view its conversations.</div>
                }
                else if (_conversations.Count == 0)
                {
                    <div class="empty-state">No conversations recorded for this session yet.</div>
                }
                else if (FilteredConversations.Count == 0)
                {
                    <div class="empty-state">
                        No conversations match <strong>"@_appliedFilter"</strong>.
                    </div>
                }
                else
                {
                    @foreach (var item in FilteredConversations)
                    {
                        var conv = item.Record;
                        var isSelected = conv.Id == _selectedConversationId;
                        <div class="list-card conversation-card @(isSelected ? "selected" : "")"
                             @onclick="() => SelectConversation(conv.Id)">
                            <div class="conversation-header">
                                <span class="turn-badge">#@item.TurnNumber</span>
                                <span class="turn-time">@FormatTimestamp(conv.CreatedAt)</span>
                            </div>
                            <div class="conversation-preview">@TruncatePreview(conv.Prompt, 110)</div>
                        </div>
                    }
                }
            </div>
        </section>
        }

        <!-- Pane 3: Conversation detail (Question/Task + Markdown Response) -->
        <main class="pane detail-pane" aria-label="Conversation Details">
            @if (SelectedConversation is null)
            {
                <div class="empty-detail">
                    <div class="empty-state">Select a conversation to view the question and model response.</div>
                </div>
            }
            else
            {
                <div class="detail-scroll">
                    <section class="detail-section prompt-section">
                        <div class="section-label">
                            <span>USER QUESTION / TASK</span>
                            <span class="section-timestamp">@FormatTimestamp(SelectedConversation.CreatedAt)</span>
                        </div>
                        <div class="prompt-box">@SelectedConversation.Prompt</div>
                    </section>

                    <section class="detail-section response-section">
                        <div class="section-label">
                            <span>MODEL RESPONSE</span>
                        </div>
                        <div class="markdown-body" @key="SelectedConversation.Id">
                            @((MarkupString)RenderMarkdown(SelectedConversation.ResponseMd))
                        </div>
                    </section>
                </div>
            }
        </main>
    </div>

    @if (_isFilterModalOpen)
    {
        <div class="filter-modal-backdrop" @onclick="CloseFilterModal">
            <div class="filter-modal-window" role="dialog" aria-modal="true" aria-label="Filter Conversations" @onclick:stopPropagation="true">
                <div class="filter-modal-header">
                    <span class="filter-modal-title">Filter Conversations</span>
                    <button type="button" class="filter-modal-close" aria-label="Close filter window" @onclick="CloseFilterModal">×</button>
                </div>
                <div class="filter-modal-body">
                    <label class="filter-input-label" for="conversation-filter-input">
                        Search term (matches question or model response)
                    </label>
                    <input id="conversation-filter-input"
                           type="text"
                           class="filter-input"
                           placeholder="Type search term…"
                           @bind="_filterDraft"
                           @bind:event="oninput"
                           @onkeydown="HandleFilterKeyDown"
                           autofocus />
                </div>
                <div class="filter-modal-footer">
                    @if (HasActiveFilter)
                    {
                        <button type="button" class="filter-btn filter-btn-secondary" @onclick="ClearFilterFromModal">
                            Clear Filter
                        </button>
                    }
                    <button type="button" class="filter-btn filter-btn-secondary" @onclick="CloseFilterModal">
                        Cancel
                    </button>
                    <button type="button" class="filter-btn filter-btn-primary" @onclick="ApplyFilter">
                        Apply Filter
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_sessionToDelete is not null)
    {
        <div class="filter-modal-backdrop" @onclick="CancelDeleteSession">
            <div class="filter-modal-window" role="dialog" aria-modal="true" aria-label="Delete Session Confirmation" @onclick:stopPropagation="true">
                <div class="filter-modal-header">
                    <span class="filter-modal-title">Delete Session</span>
                    <button type="button" class="filter-modal-close" aria-label="Close delete confirmation" @onclick="CancelDeleteSession">×</button>
                </div>
                <div class="filter-modal-body">
                    <div class="delete-confirm-text">
                        Are you sure you want to delete <strong>@_sessionToDelete.Name</strong> and all @_sessionToDelete.ConversationCount of its @(_sessionToDelete.ConversationCount == 1 ? "conversation" : "conversations")?
                    </div>
                    <div class="delete-confirm-subtext">
                        Session ID: <code>@_sessionToDelete.SessionId</code>
                    </div>
                </div>
                <div class="filter-modal-footer">
                    <button type="button" class="filter-btn filter-btn-secondary" @onclick="CancelDeleteSession">
                        Cancel
                    </button>
                    <button type="button" class="filter-btn filter-btn-danger" @onclick="ConfirmDeleteSession">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private sealed record IndexedConversation(int TurnNumber, ConversationRecord Record);

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private IReadOnlyList<RepoSummary> _repos = [];
    private IReadOnlyList<SessionRecord> _sessions = [];
    private IReadOnlyList<ConversationRecord> _conversations = [];

    private string? _selectedRepo;
    private string? _selectedSessionId;
    private long? _selectedConversationId;

    private bool _isFilterModalOpen;
    private string _filterDraft = string.Empty;
    private string _appliedFilter = string.Empty;

    private bool _isSettingsOpen;
    private bool _autoSelectNewConversation = true;
    private ConversationAddedEvent? _pendingAutoSelect;
    private SessionRecord? _sessionToDelete;
    private bool _isPanesPinned = true;

    private bool HasActiveFilter => !string.IsNullOrWhiteSpace(_appliedFilter);

    private IReadOnlyList<IndexedConversation> FilteredConversations
    {
        get
        {
            var list = new List<IndexedConversation>(_conversations.Count);
            var term = _appliedFilter.Trim();
            var hasFilter = term.Length > 0;

            for (var i = 0; i < _conversations.Count; i++)
            {
                var c = _conversations[i];
                if (!hasFilter
                    || (c.Prompt?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (c.ResponseMd?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                {
                    list.Add(new IndexedConversation(i + 1, c));
                }
            }

            return list;
        }
    }

    private ConversationRecord? SelectedConversation =>
        _selectedConversationId.HasValue
            ? FilteredConversations.Select(x => x.Record).FirstOrDefault(c => c.Id == _selectedConversationId.Value)
            : null;

    protected override void OnInitialized()
    {
        Notifier.OnConversationAdded += HandleConversationAdded;
        Notifier.OnChanged += HandleHistoryChanged;
        RefreshState();
    }

    private void HandleConversationAdded(ConversationAddedEvent evt)
    {
        _ = InvokeAsync(() =>
        {
            if (_autoSelectNewConversation)
            {
                _pendingAutoSelect = evt;
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (SelectedConversation is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("ompHistoryRenderMermaid");
            }
            catch
            {
                // Ignore transient JS interop disconnects
            }
        }
    }

    private void HandleHistoryChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshState();
            StateHasChanged();
        });
    }

    private void RefreshState()
    {
        var pending = _pendingAutoSelect;
        _pendingAutoSelect = null;

        _repos = Repository.GetRepos();

        if (_repos.Count == 0)
        {
            _selectedRepo = null;
            _sessions = [];
            _selectedSessionId = null;
            _conversations = [];
            _selectedConversationId = null;
            return;
        }

        if (pending is not null && _autoSelectNewConversation)
        {
            if (_repos.Any(r => string.Equals(r.Repo, pending.Repo, StringComparison.Ordinal)))
            {
                _selectedRepo = pending.Repo;
            }
            _selectedSessionId = pending.SessionId;
            _selectedConversationId = pending.ConversationId;
        }
        else if (string.IsNullOrEmpty(_selectedRepo) || !_repos.Any(r => string.Equals(r.Repo, _selectedRepo, StringComparison.Ordinal)))
        {
            _selectedRepo = _repos[0].Repo;
        }

        LoadSessionsForSelectedRepo(preserveSessionSelection: true);
    }

    private void SelectRepo(string repo)
    {
        if (string.Equals(_selectedRepo, repo, StringComparison.Ordinal))
        {
            return;
        }

        _selectedRepo = repo;
        _selectedSessionId = null;
        _selectedConversationId = null;
        LoadSessionsForSelectedRepo(preserveSessionSelection: false);
    }

    private void LoadSessionsForSelectedRepo(bool preserveSessionSelection)
    {
        if (string.IsNullOrEmpty(_selectedRepo))
        {
            _sessions = [];
            _selectedSessionId = null;
            _conversations = [];
            _selectedConversationId = null;
            return;
        }

        _sessions = Repository.GetSessionsByRepo(_selectedRepo);

        if (_sessions.Count == 0)
        {
            _selectedSessionId = null;
            _conversations = [];
            _selectedConversationId = null;
            return;
        }

        var sessionStillExists = preserveSessionSelection
            && !string.IsNullOrEmpty(_selectedSessionId)
            && _sessions.Any(s => string.Equals(s.SessionId, _selectedSessionId, StringComparison.Ordinal));

        if (!sessionStillExists)
        {
            _selectedSessionId = _sessions[0].SessionId;
            LoadConversationsForSelectedSession(selectFirst: true);
        }
        else
        {
            LoadConversationsForSelectedSession(selectFirst: false);
        }
    }

    private void SelectSession(string sessionId)
    {
        _selectedSessionId = sessionId;
        LoadConversationsForSelectedSession(selectFirst: true);
    }

    private void LoadConversationsForSelectedSession(bool selectFirst)
    {
        if (string.IsNullOrEmpty(_selectedSessionId))
        {
            _conversations = [];
            _selectedConversationId = null;
            return;
        }

        _conversations = Repository.GetConversations(_selectedSessionId);
        EnsureValidFilteredSelection(selectFirst);
    }

    private void EnsureValidFilteredSelection(bool selectFirst)
    {
        var visible = FilteredConversations;
        if (visible.Count == 0)
        {
            _selectedConversationId = null;
            return;
        }

        if (selectFirst || !_selectedConversationId.HasValue || !visible.Any(c => c.Record.Id == _selectedConversationId.Value))
        {
            _selectedConversationId = visible[0].Record.Id;
        }
    }

    private void SelectConversation(long conversationId)
    {
        _selectedConversationId = conversationId;
    }

    private void ToggleSettings()
    {
        _isSettingsOpen = !_isSettingsOpen;
    }

    private void OpenFilterModal()
    {
        _filterDraft = _appliedFilter;
        _isFilterModalOpen = true;
    }

    private void CloseFilterModal()
    {
        _isFilterModalOpen = false;
    }

    private void TogglePanesPinned()
    {
        _isPanesPinned = !_isPanesPinned;
    }

    private void ApplyFilter()
    {
        _appliedFilter = _filterDraft.Trim();
        _isFilterModalOpen = false;
        EnsureValidFilteredSelection(selectFirst: true);
    }

    private void ClearFilter()
    {
        _appliedFilter = string.Empty;
        _filterDraft = string.Empty;
        EnsureValidFilteredSelection(selectFirst: false);
    }

    private void ClearFilterFromModal()
    {
        _appliedFilter = string.Empty;
        _filterDraft = string.Empty;
        _isFilterModalOpen = false;
        EnsureValidFilteredSelection(selectFirst: false);
    }

    private void HandleFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplyFilter();
        }
        else if (e.Key == "Escape")
        {
            CloseFilterModal();
        }
    }

    private void RequestDeleteSession(SessionRecord session)
    {
        _sessionToDelete = session;
    }

    private void CancelDeleteSession()
    {
        _sessionToDelete = null;
    }

    private void ConfirmDeleteSession()
    {
        if (_sessionToDelete is null)
        {
            return;
        }

        var sessionId = _sessionToDelete.SessionId;
        _sessionToDelete = null;

        var wasSelected = string.Equals(_selectedSessionId, sessionId, StringComparison.Ordinal);
        if (wasSelected)
        {
            _selectedSessionId = null;
            _selectedConversationId = null;
        }
        Repository.DeleteSession(sessionId);
    }

    private static string RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return "<em>(Empty response)</em>";
        }
        return Markdown.ToHtml(markdown, Pipeline);
    }

    private static string TruncatePreview(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "(empty)";
        }

        var singleLine = string.Join(" ", text.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return singleLine.Length <= maxLength ? singleLine : singleLine[..maxLength] + "…";
    }

    private static string FormatTimestamp(string iso)
    {
        if (DateTimeOffset.TryParse(iso, out var dto))
        {
            var local = dto.ToLocalTime();
            if (local.Date == DateTimeOffset.Now.Date)
            {
                return local.ToString("HH:mm:ss");
            }
            return local.ToString("yyyy-MM-dd HH:mm");
        }
        return iso;
    }

    private static string FormatFullDateTime(string iso)
    {
        if (DateTimeOffset.TryParse(iso, out var dto))
        {
            return dto.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
        }
        return iso;
    }

    public void Dispose()
    {
        Notifier.OnConversationAdded -= HandleConversationAdded;
        Notifier.OnChanged -= HandleHistoryChanged;
    }
}
