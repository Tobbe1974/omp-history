@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject HistoryRepository Repository
@inject HistoryNotifier Notifier
@inject ActiveSessionTracker SessionTracker
@inject GitCompareService GitCompare
@inject NtfyService Ntfy
@inject IJSRuntime JS
<PageTitle>OMP History</PageTitle>

<div class="history-app">
    <HeaderBar Repos="_repos"
               SelectedRepo="@_selectedRepo"
               CopilotQuota="SessionTracker.LatestCopilotQuota"
               IsGitCompareOpen="_isGitCompareOpen"
               LeftPaneTab="@_leftPaneTab"
               OpenSuggestionCount="OpenSuggestionCount"
               IsPanesPinned="_isPanesPinned"
               OnSelectRepo="SelectRepo"
               OnToggleGitCompare="ToggleGitCompare"
               OnOpenSuggestionsTab="OpenSuggestionsTab"
               OnTogglePanesPinned="TogglePanesPinned" />

    <div class="history-workspace @(_isPanesPinned ? "" : "panes-unpinned")">
        @if (_isPanesPinned)
        {
            <SessionPane SelectedRepo="@_selectedRepo"
                         LeftPaneTab="@_leftPaneTab"
                         Sessions="_sessions"
                         SelectedSessionId="@_selectedSessionId"
                         Suggestions="_suggestions"
                         SelectedSuggestionId="_selectedSuggestionId"
                         IsSettingsOpen="_isSettingsOpen"
                         AutoSelectNewConversation="_autoSelectNewConversation"
                         AskBeforeDeleteSession="_askBeforeDeleteSession"
                         AskBeforeDeleteSuggestion="_askBeforeDeleteSuggestion"
                         NtfyEnabled="_ntfyEnabled"
                         NtfyServerUrl="@_ntfyServerUrl"
                         NtfyTopic="@_ntfyTopic"
                         NtfyStatusMessage="@_ntfyStatusMessage"
                         OnSetLeftPaneTab="SetLeftPaneTab"
                         OnSelectSession="SelectSession"
                         OnSessionContextMenu="(x) => HandleSessionContextMenu(x.Args, x.Session)"
                         OnRequestDeleteSession="RequestDeleteSession"
                         OnSelectSuggestion="SelectSuggestion"
                         OnOpenSuggestionContextMenu="(x) => OpenSuggestionContextMenu(x.Args, x.Suggestion)"
                         OnRequestDeleteSuggestion="RequestDeleteSuggestion"
                         OnToggleSettings="ToggleSettings"
                         OnAutoSelectChanged="OnAutoSelectChanged"
                         OnAskBeforeDeleteSessionChanged="OnAskBeforeDeleteSessionChanged"
                         OnAskBeforeDeleteSuggestionChanged="OnAskBeforeDeleteSuggestionChanged"
                         OnNtfyEnabledChanged="OnNtfyEnabledChanged"
                         OnNtfyServerUrlChanged="OnNtfyServerUrlChanged"
                         OnNtfyTopicChanged="OnNtfyTopicChanged" />

            <TurnListPane SelectedSessionId="@_selectedSessionId"
                          TotalConversationsCount="_conversations.Count"
                          FilteredConversations="FilteredConversations"
                          SelectedConversationId="_selectedConversationId"
                          HasActiveFilter="HasActiveFilter"
                          AppliedFilter="@_appliedFilter"
                          IsFilterModalOpen="_isFilterModalOpen"
                          OnSelectConversation="SelectConversation"
                          OnClearFilter="ClearFilter"
                          OnOpenFilterModal="OpenFilterModal" />
        }

        <!-- Pane 3: Conversation detail (Question/Task + Markdown Response) -->
        <main class="pane detail-pane" aria-label="Conversation Details">
            <FeedbackOverlay FeedbackDrafts="_feedbackDrafts"
                             IsFeedbackOpen="_isFeedbackOpen"
                             CanShowFeedbackModal="@(_isGitCompareOpen || SelectedConversation is not null)"
                             IsFeedbackBatchExpanded="_isFeedbackBatchExpanded"
                             FeedbackTopPx="_feedbackTopPx"
                             FeedbackOpenNonce="_feedbackOpenNonce"
                             FeedbackPreventKeyDefault="_feedbackPreventKeyDefault"
                             FeedbackComment="@_feedbackComment"
                             FeedbackQuotedText="@_feedbackQuotedText"
                             FeedbackLocationContext="@_feedbackLocationContext"
                             SelectedTurnNumber="SelectedTurnNumber"
                             IsGitCompareOpen="_isGitCompareOpen"
                             IsSelectedSessionActive="IsSelectedSessionActive"
                             ActiveSessionInRepo="ActiveSessionInRepo"
                             SendFeedbackButtonLabel="@SendFeedbackButtonLabel"
                             OnToggleFeedbackBatchExpanded="ToggleFeedbackBatchExpanded"
                             OnClearFeedbackBatch="ClearFeedbackBatch"
                             OnSubmitFeedbackBatchOnly="SubmitFeedbackBatchOnly"
                             OnRemoveFeedbackDraft="RemoveFeedbackDraft"
                             OnCloseFeedbackCard="CloseFeedbackCard"
                             OnClearFeedbackQuote="ClearFeedbackQuote"
                             OnFeedbackCommentInput="(val) => _feedbackComment = val"
                             OnFeedbackKeyDown="HandleFeedbackKeyDown"
                             OnAddFeedbackToBatch="AddFeedbackToBatch"
                             OnSubmitFeedback="SubmitFeedback" />
            @if (_isGitCompareOpen)
            {
                <GitComparePanel SelectedRepo="@_selectedRepo"
                                 GitOverview="_gitOverview"
                                 GitDiffResult="_gitDiffResult"
                                 GitCompareMode="@_gitCompareMode"
                                 GitOutputFormat="@_gitOutputFormat"
                                 GitBaseRef="@_gitBaseRef"
                                 GitTargetRef="@_gitTargetRef"
                                 GitFileFilter="@_gitFileFilter"
                                 FeedbackStatusMessage="@_feedbackStatusMessage"
                                 ConversationsWithSnapshots="ConversationsWithSnapshots"
                                 OnContextMenu="HandleDetailContextMenuAsync"
                                 OnSetGitOutputFormat="SetGitOutputFormat"
                                 OnRefreshGitCompare="RefreshGitCompare"
                                 OnCloseGitCompare="CloseGitCompare"
                                 OnSelectGitMode="SelectGitMode"
                                 OnGitSingleCommitChanged="OnGitSingleCommitChanged"
                                 OnGitBaseRefChanged="OnGitBaseRefChanged"
                                 OnGitTargetRefChanged="OnGitTargetRefChanged"
                                 OnGitFileFilterInput="(val) => _gitFileFilter = val"
                                 OnGitFilterKeyDown="HandleGitFilterKeyDown"
                                 OnClearGitFileFilter="ClearGitFileFilter"
                                 OnRunGitDiff="RunGitDiff"
                                 OnToggleGitFileChip="ToggleGitFileChip" />
            }
            else if (_leftPaneTab == "suggestions" && SelectedSuggestion is not null)
            {
                <div class="detail-scroll" @onclick="CloseSuggestionContextMenu">
                    <section class="detail-section suggestion-detail-header">
                        <div class="section-label">
                            <div class="section-label-left">
                                <span>CHANGE SUGGESTION #@SelectedSuggestion.Id</span>
                                @if (!string.IsNullOrWhiteSpace(SelectedSuggestion.Severity))
                                {
                                    <span class="suggestion-severity-badge severity-@SelectedSuggestion.Severity">@SelectedSuggestion.Severity.ToUpperInvariant()</span>
                                }
                                <span class="suggestion-status-badge status-@SelectedSuggestion.Status">@SelectedSuggestion.Status.ToUpperInvariant()</span>
                            </div>
                            <div class="suggestion-detail-actions">
                                @if (!string.IsNullOrEmpty(_suggestionStatusMessage))
                                {
                                    <span class="feedback-status-pill">@_suggestionStatusMessage</span>
                                }
                                <button type="button"
                                        class="filter-btn filter-btn-primary"
                                        @onclick="() => SendSuggestionChange(SelectedSuggestion)">
                                    Change suggestion
                                </button>
                                <button type="button"
                                        class="filter-btn filter-btn-danger"
                                        @onclick="() => RequestDeleteSuggestion(SelectedSuggestion)">
                                    Remove
                                </button>
                            </div>
                        </div>
                        <h2 class="suggestion-detail-title">@SelectedSuggestion.Title</h2>
                        @if (!string.IsNullOrWhiteSpace(SelectedSuggestion.FilePaths))
                        {
                            <div class="suggestion-detail-files">Files: <code>@SelectedSuggestion.FilePaths</code></div>
                        }
                    </section>

                    <section class="detail-section response-section">
                        <div class="section-label">
                            <span>HUMAN SUMMARY</span>
                            <span class="section-timestamp">@FormatTimestamp(SelectedSuggestion.CreatedAt)</span>
                        </div>
                        <div class="markdown-body">
                            @((MarkupString)GetCachedSuggestionHumanHtml(SelectedSuggestion))
                        </div>
                    </section>

                    @if (!string.IsNullOrWhiteSpace(SelectedSuggestion.AgentContext))
                    {
                        <section class="detail-section">
                            <div class="section-label">
                                <span>AGENT IMPLEMENTATION CONTEXT</span>
                            </div>
                            <div class="markdown-body">
                                @((MarkupString)GetCachedSuggestionAgentHtml(SelectedSuggestion))
                            </div>
                        </section>
                    }
                </div>
            }
            else if (SelectedConversation is null)
            {
                <div class="empty-detail">
                    <div class="empty-state">Select a conversation to view the question and model response.</div>
                </div>
            }
            else
            {
                <div class="detail-scroll"
                     @oncontextmenu="HandleDetailContextMenuAsync"
                     @oncontextmenu:preventDefault="true">
                    <section class="detail-section prompt-section">
                        <div class="section-label">
                            <span>USER QUESTION / TASK</span>
                            <span class="section-timestamp">@FormatTimestamp(SelectedConversation.CreatedAt)</span>
                        </div>
                        <div class="prompt-box">@SelectedConversation.Prompt</div>
                    </section>

                    <section class="detail-section response-section">
                        <div class="section-label">
                            <div class="section-label-left">
                                <span>MODEL RESPONSE</span>
                                @if (!string.IsNullOrWhiteSpace(SelectedConversation.Model))
                                {
                                    <span class="response-model-badge">@SelectedConversation.Model</span>
                                }
                                <span class="turn-credits-badge @(SelectedConversation.CreditsUsed.HasValue ? "" : "usage-na")"
                                      title="@FormatUsageTooltip(SelectedConversation.CreditsUsed, SelectedConversation.CostUsd, SelectedConversation.TotalTokens, SelectedConversation.Model)">
                                    Credits: @FormatCredits(SelectedConversation.CreditsUsed)
                                    @if (SelectedConversation.TotalTokens.HasValue)
                                    {
                                        <span> • @FormatTokens(SelectedConversation.TotalTokens.Value) tok</span>
                                    }
                                </span>
                                @if (SelectedConversation.SuggestionCount > 0)
                                {
                                    <button type="button"
                                            class="turn-suggestion-link-pill"
                                            title="View suggestion(s) recorded during this turn"
                                            @onclick="() => JumpToConversationSuggestions(SelectedConversation.Id)">
                                        💡 @SelectedConversation.SuggestionCount @(SelectedConversation.SuggestionCount == 1 ? "Suggestion" : "Suggestions")
                                    </button>
                                }
                                <span class="response-context-hint">Select text &amp; right-click to comment</span>
                            </div>
                            @if (!string.IsNullOrEmpty(_feedbackStatusMessage))
                            {
                                <span class="feedback-status-pill">@_feedbackStatusMessage</span>
                            }
                        </div>
                        <div class="markdown-body" @key="SelectedConversation.Id">
                            @((MarkupString)GetCachedConversationHtml(SelectedConversation))
                        </div>
                    </section>

                    @if (!string.IsNullOrWhiteSpace(SelectedConversation.DiffPatch))
                    {
                        var turnDiff = GitCompareService.ParseUnifiedDiff(
                            SelectedConversation.DiffPatch,
                            $"Turn Changes",
                            _turnFileFilter);
                        <section class="detail-section turn-diff-section" @oncontextmenu:stopPropagation="false">
                            <div class="section-label">
                                <div class="section-label-left">
                                    <span>FILES CHANGED IN THIS MESSAGE</span>
                                    <span class="git-stat-add">+@turnDiff.TotalAdditions</span>
                                    <span class="git-stat-del">-@turnDiff.TotalDeletions</span>
                                    <span>(@turnDiff.ChangedFiles.Count @(turnDiff.ChangedFiles.Count == 1 ? "file" : "files"))</span>
                                </div>
                                <div class="turn-diff-actions">
                                    <div class="git-format-toggle" role="group" aria-label="Turn diff layout">
                                        <button type="button"
                                                class="git-format-btn @(_gitOutputFormat == "line-by-line" ? "active" : "")"
                                                @onclick='() => SetTurnDiffOutputFormat("line-by-line")'>
                                            Unified
                                        </button>
                                        <button type="button"
                                                class="git-format-btn @(_gitOutputFormat == "side-by-side" ? "active" : "")"
                                                @onclick='() => SetTurnDiffOutputFormat("side-by-side")'>
                                            Side-by-Side
                                        </button>
                                    </div>
                                    @if (ConversationsWithSnapshots.Count > 0)
                                    {
                                        <button type="button"
                                                class="git-action-btn"
                                                title="Open in Git Compare to compare across any two messages"
                                                @onclick="() => OpenCompareMessagesForTurn(SelectedConversation)">
                                            ⇄ Compare Messages
                                        </button>
                                    }
                                </div>
                            </div>

                            @if (turnDiff.ChangedFiles.Count > 1)
                            {
                                <div class="git-file-chips turn-diff-file-chips">
                                    <button type="button"
                                            class="git-file-chip @(string.IsNullOrWhiteSpace(_turnFileFilter) ? "active" : "")"
                                            @onclick="ClearTurnFileFilter">
                                        All files
                                    </button>
                                    @foreach (var f in turnDiff.ChangedFiles)
                                    {
                                        var isFileSelected = string.Equals(_turnFileFilter?.Trim(), f.Path, StringComparison.Ordinal);
                                        <button type="button"
                                                class="git-file-chip @(isFileSelected ? "active" : "")"
                                                title="@f.Path (+@f.Additions / -@f.Deletions)"
                                                @onclick="() => ToggleTurnFileChip(f.Path)">
                                            <span class="git-file-status status-@f.Status.ToLowerInvariant()">@f.Status</span>
                                            <span class="git-file-name">@f.Path</span>
                                            <span class="git-stat-add">+@f.Additions</span>
                                            <span class="git-stat-del">-@f.Deletions</span>
                                        </button>
                                    }
                                </div>
                            }

                            <div id="omp-turn-diff-container" class="omp-diff2html-wrapper" @key="@($"{SelectedConversation.Id}:{_gitOutputFormat}:{_turnFileFilter}")"></div>
                        </section>
                    }
                    else if (!string.IsNullOrWhiteSpace(SelectedConversation.GitTreeBefore) || !string.IsNullOrWhiteSpace(SelectedConversation.GitTreeAfter))
                    {
                        <section class="detail-section turn-diff-section">
                            <div class="turn-no-diff-bar">
                                <span>No files modified during this message (git snapshot recorded).</span>
                                <button type="button"
                                        class="git-action-btn"
                                        @onclick="() => OpenCompareMessagesForTurn(SelectedConversation)">
                                    ⇄ Compare Messages
                                </button>
                            </div>
                        </section>
                    }
                </div>
            }
        </main>
    </div>

    @if (_isFilterModalOpen)
    {
        <div class="filter-modal-backdrop" @onclick="CloseFilterModal">
            <div class="filter-modal-window" role="dialog" aria-modal="true" aria-label="Filter Conversations" @onclick:stopPropagation="true">
                <div class="filter-modal-header">
                    <span class="filter-modal-title">Filter Conversations</span>
                    <button type="button" class="filter-modal-close" aria-label="Close filter window" @onclick="CloseFilterModal">×</button>
                </div>
                <div class="filter-modal-body">
                    <label class="filter-input-label" for="conversation-filter-input">
                        Search term (matches question or model response)
                    </label>
                    <input id="conversation-filter-input"
                           type="text"
                           class="filter-input"
                           placeholder="Type search term…"
                           @bind="_filterDraft"
                           @bind:event="oninput"
                           @onkeydown="HandleFilterKeyDown"
                           autofocus />
                </div>
                <div class="filter-modal-footer">
                    @if (HasActiveFilter)
                    {
                        <button type="button" class="filter-btn filter-btn-secondary" @onclick="ClearFilterFromModal">
                            Clear Filter
                        </button>
                    }
                    <button type="button" class="filter-btn filter-btn-secondary" @onclick="CloseFilterModal">
                        Cancel
                    </button>
                    <button type="button" class="filter-btn filter-btn-primary" @onclick="ApplyFilter">
                        Apply Filter
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_sessionToDelete is not null)
    {
        <div class="filter-modal-backdrop" @onclick="CancelDeleteSession">
            <div class="filter-modal-window" role="dialog" aria-modal="true" aria-label="Delete Session Confirmation" @onclick:stopPropagation="true">
                <div class="filter-modal-header">
                    <span class="filter-modal-title">Delete Session</span>
                    <button type="button" class="filter-modal-close" aria-label="Close delete confirmation" @onclick="CancelDeleteSession">×</button>
                </div>
                <div class="filter-modal-body">
                    <div class="delete-confirm-text">
                        Are you sure you want to delete <strong>@_sessionToDelete.Name</strong> and all @_sessionToDelete.ConversationCount of its @(_sessionToDelete.ConversationCount == 1 ? "conversation" : "conversations")?
                    </div>
                    <div class="delete-confirm-subtext">
                        Session ID: <code>@_sessionToDelete.SessionId</code>
                    </div>
                </div>
                <div class="filter-modal-footer">
                    <button type="button" class="filter-btn filter-btn-secondary" @onclick="CancelDeleteSession">
                        Cancel
                    </button>
                    <button type="button" class="filter-btn filter-btn-danger" @onclick="ConfirmDeleteSession">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_suggestionToDelete is not null)
    {
        <div class="filter-modal-backdrop" @onclick="CancelDeleteSuggestion">
            <div class="filter-modal-window" role="dialog" aria-modal="true" aria-label="Delete Suggestion Confirmation" @onclick:stopPropagation="true">
                <div class="filter-modal-header">
                    <span class="filter-modal-title">Remove Suggestion</span>
                    <button type="button" class="filter-modal-close" aria-label="Close remove confirmation" @onclick="CancelDeleteSuggestion">×</button>
                </div>
                <div class="filter-modal-body">
                    <div class="delete-confirm-text">
                        Are you sure you want to remove <strong>@_suggestionToDelete.Title</strong>?
                    </div>
                </div>
                <div class="filter-modal-footer">
                    <button type="button" class="filter-btn filter-btn-secondary" @onclick="CancelDeleteSuggestion">
                        Cancel
                    </button>
                    <button type="button" class="filter-btn filter-btn-danger" @onclick="ConfirmDeleteSuggestion">
                        Remove
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_contextMenuSuggestion is not null)
    {
        <div class="suggestion-context-backdrop" @onclick="CloseSuggestionContextMenu">
            <div class="suggestion-context-menu"
                 style="left: @(_suggestionContextLeftPx)px; top: @(_suggestionContextTopPx)px;"
                 role="menu"
                 @onclick:stopPropagation="true">
                <button type="button" class="suggestion-context-item" role="menuitem" @onclick="() => { var s = _contextMenuSuggestion!; CloseSuggestionContextMenu(); SendSuggestionChange(s); }">
                    Change suggestion
                </button>
                <button type="button" class="suggestion-context-item" role="menuitem" @onclick="() => { var s = _contextMenuSuggestion!; CloseSuggestionContextMenu(); RequestDeleteSuggestion(s); }">
                    Remove
                </button>
            </div>
        </div>
    }
</div>

@code {
    private sealed record SelectionCaptureResult(string? Text, string? LocationContext);

    private IReadOnlyList<RepoSummary> _repos = [];
    private IReadOnlyList<SessionRecord> _sessions = [];
    private IReadOnlyList<ConversationRecord> _conversations = [];

    private string? _selectedRepo;
    private string? _selectedSessionId;
    private long? _selectedConversationId;
    private IReadOnlyList<SuggestionRecord> _suggestions = [];
    private string _leftPaneTab = "sessions";
    private long? _selectedSuggestionId;
    private SuggestionRecord? _suggestionToDelete;
    private SuggestionRecord? _contextMenuSuggestion;
    private int _suggestionContextLeftPx;
    private int _suggestionContextTopPx;
    private string? _suggestionStatusMessage;

    private bool _isFilterModalOpen;
    private string _filterDraft = string.Empty;
    private string _appliedFilter = string.Empty;

    private bool _isSettingsOpen;
    private bool _autoSelectNewConversation = true;
    private bool _ntfyEnabled;
    private string _ntfyServerUrl = "https://skegriebyavag13.duckdns.org";
    private string _ntfyTopic = "omp-history";
    private string? _ntfyStatusMessage;
    private ConversationAddedEvent? _pendingAutoSelect;
    private SessionRecord? _sessionToDelete;
    private bool _askBeforeDeleteSession = true;
    private bool _askBeforeDeleteSuggestion = true;
    private bool _isPanesPinned = true;
    private bool _isFeedbackOpen;
    private int _feedbackOpenNonce;
    private bool _feedbackPreventKeyDefault;
    private string _feedbackComment = string.Empty;
    private string? _feedbackQuotedText;
    private string? _feedbackLocationContext;
    private int _feedbackTopPx = 140;
    private string? _feedbackStatusMessage;
    private readonly List<FeedbackDraftItem> _feedbackDrafts = [];
    private bool _isFeedbackBatchExpanded;
    private System.Threading.Timer? _activeStatusTimer;
    private bool _isGitCompareOpen;
    private string _gitCompareMode = "latest";
    private string _gitOutputFormat = "line-by-line";
    private string _gitBaseRef = "HEAD~1";
    private string _gitTargetRef = "HEAD";
    private string _gitFileFilter = string.Empty;
    private GitRepoOverview? _gitOverview;
    private GitDiffResult? _gitDiffResult;
    private bool _gitDiffNeedsRender;
    private string _turnFileFilter = string.Empty;
    private long? _lastJsRenderedConversationId;
    private long? _lastJsRenderedSuggestionId;
    private string? _lastJsRenderedLeftPaneTab;
    private string? _lastJsRenderedTurnFilter;
    private string? _lastJsRenderedTurnFormat;
    private long? _cachedMdConversationId;
    private string? _cachedMdConversationSource;
    private string _cachedMdConversationHtml = string.Empty;
    private long? _cachedMdSuggestionId;
    private string? _cachedMdSuggestionHumanSource;
    private string _cachedMdSuggestionHumanHtml = string.Empty;
    private string? _cachedMdSuggestionAgentSource;
    private string _cachedMdSuggestionAgentHtml = string.Empty;

    private bool IsSelectedSessionActive => SessionTracker.IsSessionActive(_selectedSessionId);

    private SessionRecord? ActiveSessionInRepo =>
        _sessions.FirstOrDefault(s => SessionTracker.IsSessionActive(s.SessionId));
    private bool HasActiveFilter => !string.IsNullOrWhiteSpace(_appliedFilter);

    private IReadOnlyList<IndexedConversation> FilteredConversations
    {
        get
        {
            var list = new List<IndexedConversation>(_conversations.Count);
            var term = _appliedFilter.Trim();
            var hasFilter = term.Length > 0;

            for (var i = 0; i < _conversations.Count; i++)
            {
                var c = _conversations[i];
                if (!hasFilter
                    || (c.Prompt?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (c.ResponseMd?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                {
                    list.Add(new IndexedConversation(i + 1, c));
                }
            }

            return list;
        }
    }

    private IReadOnlyList<IndexedConversation> ConversationsWithSnapshots
    {
        get
        {
            var list = new List<IndexedConversation>();
            for (var i = 0; i < _conversations.Count; i++)
            {
                var c = _conversations[i];
                if (!string.IsNullOrWhiteSpace(c.GitTreeBefore) || !string.IsNullOrWhiteSpace(c.GitTreeAfter))
                {
                    list.Add(new IndexedConversation(i + 1, c));
                }
            }
            return list;
        }
    }

    private ConversationRecord? SelectedConversation =>
        _selectedConversationId.HasValue
            ? FilteredConversations.Select(x => x.Record).FirstOrDefault(c => c.Id == _selectedConversationId.Value)
            : null;

    private SuggestionRecord? SelectedSuggestion =>
        _selectedSuggestionId.HasValue
            ? _suggestions.FirstOrDefault(s => s.Id == _selectedSuggestionId.Value)
            : null;

    private int OpenSuggestionCount => _suggestions.Count(s => string.Equals(s.Status, "open", StringComparison.OrdinalIgnoreCase));

    private int? SelectedTurnNumber =>
        _selectedConversationId.HasValue
            ? FilteredConversations.FirstOrDefault(x => x.Record.Id == _selectedConversationId.Value)?.TurnNumber
            : null;

    private string SendFeedbackButtonLabel
    {
        get
        {
            var hasCurrent = !string.IsNullOrWhiteSpace(_feedbackComment);
            var total = _feedbackDrafts.Count + (hasCurrent ? 1 : 0);
            return total > 1 ? $"Send All ({total})" : "Send";
        }
    }
    protected override void OnInitialized()
    {
        Notifier.OnConversationAdded += HandleConversationAdded;
        Notifier.OnChanged += HandleHistoryChanged;
        LoadGlobalSettings();
        RefreshState();
        _activeStatusTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void HandleConversationAdded(ConversationAddedEvent evt)
    {
        _ = InvokeAsync(() =>
        {
            if (_autoSelectNewConversation)
            {
                _pendingAutoSelect = evt;
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isGitCompareOpen && _gitDiffNeedsRender)
        {
            _gitDiffNeedsRender = false;
            try
            {
                await JS.InvokeVoidAsync(
                    "ompHistoryRenderGitDiff",
                    "omp-git-diff-container",
                    _gitDiffResult?.RawDiff ?? string.Empty,
                    _gitOutputFormat,
                    true);
            }
            catch
            {
                // Ignore transient JS interop disconnects
            }
        }
        else if (!_isGitCompareOpen && _leftPaneTab == "suggestions" && SelectedSuggestion is not null)
        {
            if (_lastJsRenderedLeftPaneTab != _leftPaneTab || _lastJsRenderedSuggestionId != SelectedSuggestion.Id)
            {
                _lastJsRenderedLeftPaneTab = _leftPaneTab;
                _lastJsRenderedSuggestionId = SelectedSuggestion.Id;
                try
                {
                    await JS.InvokeVoidAsync("ompHistoryRenderMermaid");
                }
                catch
                {
                    // Ignore transient JS interop disconnects
                }
            }
        }
        else if (!_isGitCompareOpen && SelectedConversation is not null)
        {
            var convChanged = _lastJsRenderedLeftPaneTab != _leftPaneTab
                || _lastJsRenderedConversationId != SelectedConversation.Id;
            var diffChanged = convChanged
                || _lastJsRenderedTurnFilter != _turnFileFilter
                || _lastJsRenderedTurnFormat != _gitOutputFormat;

            if (convChanged || diffChanged)
            {
                _lastJsRenderedLeftPaneTab = _leftPaneTab;
                _lastJsRenderedConversationId = SelectedConversation.Id;
                _lastJsRenderedTurnFilter = _turnFileFilter;
                _lastJsRenderedTurnFormat = _gitOutputFormat;

                try
                {
                    if (convChanged)
                    {
                        await JS.InvokeVoidAsync("ompHistoryRenderMermaid");
                    }
                    if (diffChanged && !string.IsNullOrWhiteSpace(SelectedConversation.DiffPatch))
                    {
                        var turnDiff = GitCompareService.ParseUnifiedDiff(
                            SelectedConversation.DiffPatch,
                            "Turn Changes",
                            _turnFileFilter);
                        await JS.InvokeVoidAsync(
                            "ompHistoryRenderGitDiff",
                            "omp-turn-diff-container",
                            turnDiff.RawDiff,
                            _gitOutputFormat,
                            turnDiff.ChangedFiles.Count > 1);
                    }
                }
                catch
                {
                    // Ignore transient JS interop disconnects
                }
            }
        }
    }

