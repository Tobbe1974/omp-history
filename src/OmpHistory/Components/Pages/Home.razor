    private async Task HandleDetailContextMenuAsync(MouseEventArgs e)
    {
        if ((!_isGitCompareOpen && SelectedConversation is null) || string.IsNullOrEmpty(_selectedSessionId))
        {
            return;
        }

        string selectedText = string.Empty;
        string locationContext = string.Empty;
        try
        {
            var capture = await JS.InvokeAsync<SelectionCaptureResult?>("ompHistoryCaptureSelection");
            if (capture is not null)
            {
                selectedText = capture.Text ?? string.Empty;
                locationContext = capture.LocationContext ?? string.Empty;
            }
        }
        catch
        {
            // ignore JS interop failures
        }

        _feedbackComment = string.Empty;
        _feedbackPreventKeyDefault = false;
        _feedbackOpenNonce++;
        _feedbackQuotedText = string.IsNullOrWhiteSpace(selectedText) ? null : selectedText.Trim();
        _feedbackLocationContext = string.IsNullOrWhiteSpace(locationContext) ? null : locationContext.Trim();
        _feedbackTopPx = (int)Math.Clamp(e.ClientY - 24, 68, 480);
        _isFeedbackOpen = true;
        _feedbackStatusMessage = null;
    }

