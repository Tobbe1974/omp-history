    private void HandleFeedbackKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            _feedbackPreventKeyDefault = true;
            SubmitFeedback();
        }
        else if (e.Key == "Enter" && e.ShiftKey)
        {
            _feedbackPreventKeyDefault = true;
            AddFeedbackToBatch();
        }
        else if (e.Key == "Escape")
        {
            _feedbackPreventKeyDefault = true;
            CloseFeedbackCard();
        }
        else
        {
            _feedbackPreventKeyDefault = false;
        }
    }

    private void AddFeedbackToBatch()
    {
        if (string.IsNullOrWhiteSpace(_feedbackComment))
        {
            return;
        }

        var draft = CreateCurrentDraftItem();
        if (draft is not null)
        {
            _feedbackDrafts.Add(draft);
        }

        _isFeedbackOpen = false;
        _feedbackComment = string.Empty;
        _feedbackQuotedText = null;
        _feedbackLocationContext = null;
        _feedbackStatusMessage = $"Added to batch ({_feedbackDrafts.Count} staged)";
    }

