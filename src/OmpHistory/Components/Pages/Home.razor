    private FeedbackDraftItem? CreateCurrentDraftItem()
    {
        if (string.IsNullOrWhiteSpace(_feedbackComment))
        {
            return null;
        }

        var turnNum = _isGitCompareOpen ? null : SelectedTurnNumber;
        var loc = _feedbackLocationContext;
        if (_isGitCompareOpen && string.IsNullOrWhiteSpace(loc))
        {
            loc = $"Git Compare ({_gitCompareMode})";
        }

        return new FeedbackDraftItem(
            Id: Guid.NewGuid().ToString("N"),
            ConversationId: SelectedConversation?.Id,
            TurnNumber: turnNum,
            LocationContext: loc,
            QuotedText: _feedbackQuotedText,
            Comment: _feedbackComment.Trim());
    }

    private void SubmitFeedbackBatchOnly()
    {
        if (string.IsNullOrWhiteSpace(_selectedSessionId) || _feedbackDrafts.Count == 0)
        {
            return;
        }

        var isActive = IsSelectedSessionActive;
        var count = _feedbackDrafts.Count;
        SessionTracker.EnqueueFeedbackBatch(_selectedSessionId, _feedbackDrafts.ToList());
        _feedbackDrafts.Clear();
        _isFeedbackBatchExpanded = false;
        _isFeedbackOpen = false;
        _feedbackComment = string.Empty;
        _feedbackQuotedText = null;
        _feedbackLocationContext = null;
        _feedbackStatusMessage = isActive
            ? $"Sent {count} feedback {(count == 1 ? "comment" : "comments")} to active OMP session"
            : $"Queued {count} feedback {(count == 1 ? "comment" : "comments")} (will deliver when session becomes active)";
    }

    private void SubmitFeedback()
    {
        if (string.IsNullOrWhiteSpace(_selectedSessionId))
        {
            return;
        }

        var currentDraft = CreateCurrentDraftItem();
        if (currentDraft is null && _feedbackDrafts.Count == 0)
        {
            return;
        }

        var allDrafts = new List<FeedbackDraftItem>(_feedbackDrafts);
        if (currentDraft is not null)
        {
            allDrafts.Add(currentDraft);
        }

        var isActive = IsSelectedSessionActive;
        var count = allDrafts.Count;
        SessionTracker.EnqueueFeedbackBatch(_selectedSessionId, allDrafts);

        _feedbackDrafts.Clear();
        _isFeedbackBatchExpanded = false;
        _isFeedbackOpen = false;
        _feedbackComment = string.Empty;
        _feedbackQuotedText = null;
        _feedbackLocationContext = null;
        _feedbackStatusMessage = isActive
            ? (count > 1 ? $"Sent {count} feedback comments to active OMP session" : "Feedback sent to active OMP session")
            : (count > 1 ? $"Queued {count} feedback comments for session" : "Feedback queued (will deliver when session becomes active)");
    }

