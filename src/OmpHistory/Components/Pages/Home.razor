@page "/"
@rendermode InteractiveServer
@implements IDisposable
@using Markdig
@inject HistoryRepository Repository
@inject HistoryNotifier Notifier
@inject ActiveSessionTracker SessionTracker
@inject GitCompareService GitCompare
@inject IJSRuntime JS

<PageTitle>OMP History</PageTitle>

<div class="history-app">
    <header class="history-header">
        <div class="brand">
            <span class="brand-dot"></span>
            <span class="brand-title">OMP History</span>
        </div>

        <div class="repo-selector">
            <span class="repo-label">REPO</span>
            @if (_repos.Count == 0)
            {
                <span class="repo-empty">No repositories recorded yet</span>
            }
            else
            {
                <div class="repo-pills" role="tablist" aria-label="Repositories">
                    @foreach (var repo in _repos)
                    {
                        var isSelected = string.Equals(repo.Repo, _selectedRepo, StringComparison.Ordinal);
                        <button type="button"
                                class="repo-pill @(isSelected ? "active" : "")"
                                @onclick="() => SelectRepo(repo.Repo)">
                            <span class="repo-name">@repo.Repo</span>
                            <span class="repo-count">@repo.SessionCount</span>
                        </button>
                    }
                </div>
            }
        </div>

        <div class="header-actions">
            <button type="button"
                    class="pin-panes-btn git-compare-header-btn @(_isGitCompareOpen ? "active" : "")"
                    title="@(_isGitCompareOpen ? "Close Git Compare and return to conversation" : "Open Git Compare for the selected repository")"
                    aria-label="Toggle Git Compare"
                    aria-pressed="@(_isGitCompareOpen ? "true" : "false")"
                    disabled="@string.IsNullOrEmpty(_selectedRepo)"
                    @onclick="ToggleGitCompare">
                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="4" cy="3.5" r="1.75" />
                    <circle cx="4" cy="12.5" r="1.75" />
                    <circle cx="12" cy="12.5" r="1.75" />
                    <path d="M4 5.25v5.5M12 10.75V6.5a2.5 2.5 0 0 0-2.5-2.5H7" />
                    <path d="M8.5 2L6.5 4l2 2" />
                </svg>
                <span>Git Compare</span>
            </button>

            <button type="button"
                    class="pin-panes-btn @(_isPanesPinned ? "active" : "")"
                    title="@(_isPanesPinned ? "Unpin to hide Sessions and Conversations" : "Pin to show Sessions and Conversations")"
                    aria-label="Pin Sessions and Conversations panes"
                    aria-pressed="@(_isPanesPinned ? "true" : "false")"
                    @onclick="TogglePanesPinned">
                <svg viewBox="0 0 16 16" width="13" height="13" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9.5 2.5L13.5 6.5L12 8L9.5 7.5L6.5 10.5L7 13L5.5 14.5L3 12L1.5 14.5L3.5 12.5L1.5 10.5L3 9L5.5 9.5L8.5 6.5L8 4L9.5 2.5Z" />
                </svg>
                <span>Pin Lists</span>
            </button>

            <div class="header-status">
                <span class="live-indicator"></span>
                <span>Live</span>
            </div>
        </div>
    </header>

    <div class="history-workspace @(_isPanesPinned ? "" : "panes-unpinned")">
        @if (_isPanesPinned)
        {
        <aside class="pane sessions-pane" aria-label="Sessions">
            <div class="pane-header">
                <span>SESSIONS @(string.IsNullOrEmpty(_selectedRepo) ? "" : $"({_sessions.Count})")</span>
            </div>

            <div class="pane-body">
                @if (string.IsNullOrEmpty(_selectedRepo))
                {
                    <div class="empty-state">Select or create a session from OMP to begin.</div>
                }
                else if (_sessions.Count == 0)
                {
                    <div class="empty-state">No sessions in <strong>@_selectedRepo</strong>.</div>
                }
                else
                {
                    @foreach (var session in _sessions)
                    {
                        var isSelected = string.Equals(session.SessionId, _selectedSessionId, StringComparison.Ordinal);
                        var isActiveSession = SessionTracker.IsSessionActive(session.SessionId);
                        <div class="list-card session-card @(isSelected ? "selected" : "") @(isActiveSession ? "active-omp-session" : "")"
                             @onclick="() => SelectSession(session.SessionId)">
                            <div class="session-card-main">
                                <div class="session-title-row">
                                    <div class="session-title" title="@session.Name">@session.Name</div>
                                    @if (isActiveSession)
                                    {
                                        <span class="session-active-badge" title="Active in OMP terminal">
                                            <span class="session-active-dot"></span>
                                            ACTIVE
                                        </span>
                                    }
                                </div>
                                <div class="session-id" title="@session.SessionId">@session.SessionId</div>
                                <div class="session-meta">
                                    <span>@session.ConversationCount @(session.ConversationCount == 1 ? "turn" : "turns")</span>
                                    <span>•</span>
                                    <span title="@session.UpdatedAt">@FormatFullDateTime(session.UpdatedAt)</span>
                                </div>
                            </div>
                            <button type="button"
                                    class="delete-session-btn"
                                    title="Delete session"
                                    aria-label="Delete session @session.Name"
                                    @onclick:stopPropagation="true"
                                    @onclick="() => RequestDeleteSession(session)">
                                ×
                            </button>
                        </div>
                    }
                }
            </div>

            <div class="sessions-footer">
                @if (_isSettingsOpen)
                {
                    <div class="settings-popover" role="dialog" aria-label="Settings">
                        <div class="settings-popover-header">
                            <span>Settings</span>
                            <button type="button"
                                    class="settings-popover-close"
                                    aria-label="Close settings"
                                    @onclick="ToggleSettings">×</button>
                        </div>
                        <label class="settings-checkbox-row">
                            <input type="checkbox" @bind="_autoSelectNewConversation" />
                            <span>Auto-select new conversations</span>
                        </label>
                    </div>
                }

                <button type="button"
                        class="settings-cog-btn @(_isSettingsOpen ? "active" : "")"
                        title="Settings"
                        aria-label="Settings"
                        @onclick="ToggleSettings">
                    <svg viewBox="0 0 20 20" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="10" cy="10" r="2.6" />
                        <path d="M16.2 12.3a1.3 1.3 0 0 0 .26 1.43l.05.05a1.55 1.55 0 1 1-2.2 2.2l-.05-.05a1.3 1.3 0 0 0-1.43-.26 1.3 1.3 0 0 0-.78 1.19v.14a1.55 1.55 0 1 1-3.1 0v-.07a1.3 1.3 0 0 0-.84-1.19 1.3 1.3 0 0 0-1.43.26l-.05.05a1.55 1.55 0 1 1-2.2-2.2l.05-.05a1.3 1.3 0 0 0 .26-1.43 1.3 1.3 0 0 0-1.19-.78h-.14a1.55 1.55 0 1 1 0-3.1h.07a1.3 1.3 0 0 0 1.19-.84 1.3 1.3 0 0 0-.26-1.43l-.05-.05a1.55 1.55 0 1 1 2.2-2.2l.05.05a1.3 1.3 0 0 0 1.43.26h.06a1.3 1.3 0 0 0 .78-1.19v-.14a1.55 1.55 0 1 1 3.1 0v.07a1.3 1.3 0 0 0 .78 1.19 1.3 1.3 0 0 0 1.43-.26l.05-.05a1.55 1.55 0 1 1 2.2 2.2l-.05.05a1.3 1.3 0 0 0-.26 1.43v.06a1.3 1.3 0 0 0 1.19.78h.14a1.55 1.55 0 1 1 0 3.1h-.07a1.3 1.3 0 0 0-1.19.78z" />
                    </svg>
                    <span class="settings-cog-label">Settings</span>
                </button>
            </div>
        </aside>

        <!-- Pane 2: Conversations in selected session -->
        <section class="pane conversations-pane" aria-label="Conversations">
            <div class="pane-header">
                <span>
                    CONVERSATIONS
                    @if (_conversations.Count > 0)
                    {
                        if (HasActiveFilter)
                        {
                            <span>(@FilteredConversations.Count / @_conversations.Count)</span>
                        }
                        else
                        {
                            <span>(@_conversations.Count)</span>
                        }
                    }
                </span>

                <div class="pane-header-actions">
                    @if (HasActiveFilter)
                    {
                        <span class="active-filter-chip" title="Filtered by: @_appliedFilter">@_appliedFilter</span>
                        <button type="button"
                                class="funnel-btn clear-funnel-btn"
                                title="Remove filter"
                                aria-label="Remove conversation filter"
                                @onclick="ClearFilter">
                            <svg viewBox="0 0 20 20" width="15" height="15" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M2.5 3.5h13l-5 6v5l-3 1.5v-6.5l-5-6z" />
                                <path d="M14.5 12.5l4 4m0-4l-4 4" stroke-width="2" />
                            </svg>
                        </button>
                    }
                    <button type="button"
                            class="funnel-btn @(HasActiveFilter || _isFilterModalOpen ? "active" : "")"
                            title="Filter conversations"
                            aria-label="Filter conversations"
                            @onclick="OpenFilterModal">
                        <svg viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M2.5 3.5h15l-6 6.5v5.5l-3 1.5v-7l-6-6.5z" />
                        </svg>
                    </button>
                </div>
            </div>

            <div class="pane-body">
                @if (string.IsNullOrEmpty(_selectedSessionId))
                {
                    <div class="empty-state">Select a session to view its conversations.</div>
                }
                else if (_conversations.Count == 0)
                {
                    <div class="empty-state">No conversations recorded for this session yet.</div>
                }
                else if (FilteredConversations.Count == 0)
                {
                    <div class="empty-state">
                        No conversations match <strong>"@_appliedFilter"</strong>.
                    </div>
                }
                else
                {
                    @foreach (var item in FilteredConversations)
                    {
                        var conv = item.Record;
                        var isSelected = conv.Id == _selectedConversationId;
                        <div class="list-card conversation-card @(isSelected ? "selected" : "")"
                             @onclick="() => SelectConversation(conv.Id)">
                            <div class="conversation-header">
                                <span class="turn-badge">#@item.TurnNumber</span>
                                <span class="turn-time">@FormatTimestamp(conv.CreatedAt)</span>
                            </div>
                            <div class="conversation-preview">@TruncatePreview(conv.Prompt, 110)</div>
                        </div>
                    }
                }
            </div>
        </section>
        }

        <!-- Pane 3: Conversation detail (Question/Task + Markdown Response) -->
        <main class="pane detail-pane" aria-label="Conversation Details">
            @if (_isGitCompareOpen)
            {
                <div class="detail-scroll git-compare-scroll"
                     @oncontextmenu="HandleDetailContextMenuAsync"
                     @oncontextmenu:preventDefault="true">
                    <section class="git-compare-toolbar-card" @oncontextmenu:stopPropagation="true">
                        <div class="git-compare-top-row">
                            <div class="git-compare-title-group">
                                <span class="git-compare-badge">GIT COMPARE</span>
                                <span class="git-compare-repo-name">@_selectedRepo</span>
                                @if (_gitOverview?.IsAvailable == true)
                                {
                                    <span class="git-branch-chip" title="Current branch">
                                        ⎇ @_gitOverview.CurrentBranch
                                    </span>
                                    @if (!string.IsNullOrEmpty(_gitOverview.RepoPath))
                                    {
                                        <span class="git-repo-path" title="@_gitOverview.RepoPath">@_gitOverview.RepoPath</span>
                                    }
                                }
                            </div>

                            <div class="git-compare-top-actions">
                                @if (!string.IsNullOrEmpty(_feedbackStatusMessage))
                                {
                                    <span class="feedback-status-pill">@_feedbackStatusMessage</span>
                                }
                                <div class="git-format-toggle" role="group" aria-label="Diff layout">
                                    <button type="button"
                                            class="git-format-btn @(_gitOutputFormat == "line-by-line" ? "active" : "")"
                                            @onclick='() => SetGitOutputFormat("line-by-line")'>
                                        Unified
                                    </button>
                                    <button type="button"
                                            class="git-format-btn @(_gitOutputFormat == "side-by-side" ? "active" : "")"
                                            @onclick='() => SetGitOutputFormat("side-by-side")'>
                                        Side-by-Side
                                    </button>
                                </div>
                                <button type="button"
                                        class="git-action-btn"
                                        title="Refresh git status & diff"
                                        @onclick="RefreshGitCompare">
                                    ↻ Refresh
                                </button>
                                <button type="button"
                                        class="git-action-btn git-close-btn"
                                        title="Close Git Compare"
                                        @onclick="CloseGitCompare">
                                    ✕ Close
                                </button>
                            </div>
                        </div>

                        <div class="git-compare-controls-row">
                            <div class="git-mode-tabs" role="tablist" aria-label="What to compare">
                                <button type="button"
                                        class="git-mode-tab @(_gitCompareMode == "working" ? "active" : "")"
                                        @onclick='() => SelectGitMode("working")'>
                                    <span>Working Tree</span>
                                    @if (_gitOverview is not null && _gitOverview.UncommittedFileCount > 0)
                                    {
                                        <span class="git-mode-count">@_gitOverview.UncommittedFileCount</span>
                                    }
                                </button>
                                <button type="button"
                                        class="git-mode-tab @(_gitCompareMode == "latest" ? "active" : "")"
                                        @onclick='() => SelectGitMode("latest")'>
                                    <span>Commit Changes</span>
                                </button>
                                <button type="button"
                                        class="git-mode-tab @(_gitCompareMode == "compare" ? "active" : "")"
                                        @onclick='() => SelectGitMode("compare")'>
                                    <span>Compare Refs / Commits</span>
                                </button>
                            </div>

                            @if (_gitCompareMode == "latest" && _gitOverview?.IsAvailable == true)
                            {
                                <div class="git-ref-selectors">
                                    <label class="git-ref-label">
                                        <span>Commit</span>
                                        <select class="git-ref-select" value="@_gitTargetRef" @onchange="OnGitSingleCommitChanged">
                                            @foreach (var c in _gitOverview.RecentCommits)
                                            {
                                                <option value="@c.ShortHash">@c.ShortHash — @TruncatePreview(c.Subject, 55) (@c.RelativeDate)</option>
                                            }
                                        </select>
                                    </label>
                                </div>
                            }
                            else if (_gitCompareMode == "compare" && _gitOverview?.IsAvailable == true)
                            {
                                <div class="git-ref-selectors">
                                    <label class="git-ref-label">
                                        <span>Base (From)</span>
                                        <select class="git-ref-select" value="@_gitBaseRef" @onchange="OnGitBaseRefChanged">
                                            <optgroup label="Branches">
                                                @foreach (var b in _gitOverview.Branches)
                                                {
                                                    <option value="@b">⎇ @b</option>
                                                }
                                            </optgroup>
                                            <optgroup label="Recent Commits">
                                                @foreach (var c in _gitOverview.RecentCommits)
                                                {
                                                    <option value="@c.ShortHash">@c.ShortHash — @TruncatePreview(c.Subject, 45) (@c.RelativeDate)</option>
                                                }
                                            </optgroup>
                                        </select>
                                    </label>
                                    <span class="git-ref-arrow">→</span>
                                    <label class="git-ref-label">
                                        <span>Target (To)</span>
                                        <select class="git-ref-select" value="@_gitTargetRef" @onchange="OnGitTargetRefChanged">
                                            <option value="WORKING">Working Tree (Uncommitted + Committed)</option>
                                            <option value="HEAD">HEAD (@(_gitOverview.HeadCommit ?? "latest"))</option>
                                            <optgroup label="Branches">
                                                @foreach (var b in _gitOverview.Branches)
                                                {
                                                    <option value="@b">⎇ @b</option>
                                                }
                                            </optgroup>
                                            <optgroup label="Recent Commits">
                                                @foreach (var c in _gitOverview.RecentCommits)
                                                {
                                                    <option value="@c.ShortHash">@c.ShortHash — @TruncatePreview(c.Subject, 45) (@c.RelativeDate)</option>
                                                }
                                            </optgroup>
                                        </select>
                                    </label>
                                </div>
                            }

                            <div class="git-file-filter-box">
                                <input type="text"
                                       class="git-file-filter-input"
                                       placeholder="Filter by file path (e.g. omp-addon/extensions/omp-history.ts)…"
                                       @bind="_gitFileFilter"
                                       @bind:event="oninput"
                                       @onkeydown="HandleGitFilterKeyDown" />
                                @if (!string.IsNullOrWhiteSpace(_gitFileFilter))
                                {
                                    <button type="button"
                                            class="git-file-filter-clear"
                                            title="Show all files"
                                            @onclick="ClearGitFileFilter">×</button>
                                }
                                <button type="button"
                                        class="git-action-btn"
                                        @onclick="RunGitDiff">
                                    Apply
                                </button>
                            </div>
                        </div>

                        @if (_gitDiffResult?.IsAvailable == true && _gitDiffResult.ChangedFiles.Count > 0)
                        {
                            <div class="git-files-bar">
                                <div class="git-stats-summary">
                                    <span><strong>@_gitDiffResult.ChangedFiles.Count</strong> @(_gitDiffResult.ChangedFiles.Count == 1 ? "file" : "files") changed</span>
                                    <span class="git-stat-add">+@_gitDiffResult.TotalAdditions</span>
                                    <span class="git-stat-del">-@_gitDiffResult.TotalDeletions</span>
                                    <span class="response-context-hint">• Select diff lines &amp; right-click to send Feedback to OMP</span>
                                </div>
                                <div class="git-file-chips">
                                    <button type="button"
                                            class="git-file-chip @(string.IsNullOrWhiteSpace(_gitFileFilter) ? "active" : "")"
                                            @onclick="ClearGitFileFilter">
                                        All files
                                    </button>
                                    @foreach (var f in _gitDiffResult.ChangedFiles)
                                    {
                                        var isFileSelected = string.Equals(_gitFileFilter?.Trim(), f.Path, StringComparison.Ordinal);
                                        <button type="button"
                                                class="git-file-chip @(isFileSelected ? "active" : "")"
                                                title="@f.Path (+@f.Additions / -@f.Deletions)"
                                                @onclick="() => ToggleGitFileChip(f.Path)">
                                            <span class="git-file-status status-@f.Status.ToLowerInvariant()">@f.Status</span>
                                            <span class="git-file-name">@f.Path</span>
                                            <span class="git-stat-add">+@f.Additions</span>
                                            <span class="git-stat-del">-@f.Deletions</span>
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </section>

                    @if (_gitOverview?.IsAvailable != true)
                    {
                        <div class="git-empty-box">
                            <div class="empty-state">@(_gitOverview?.Error ?? "Local git repository not found.")</div>
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_gitDiffResult?.Error))
                    {
                        <div class="git-empty-box">
                            <div class="empty-state">@_gitDiffResult.Error</div>
                        </div>
                    }
                    else if (string.IsNullOrWhiteSpace(_gitDiffResult?.RawDiff))
                    {
                        <div class="git-empty-box">
                            <div class="empty-state">
                                No differences found for <strong>@(_gitDiffResult?.Title ?? _gitCompareMode)</strong>@(string.IsNullOrWhiteSpace(_gitFileFilter) ? "." : $" matching '{_gitFileFilter}'.")
                            </div>
                        </div>
                    }
                    else
                    {
                        <div id="omp-git-diff-container" class="omp-diff2html-wrapper"></div>
                    }
                </div>
            }
            else if (SelectedConversation is null)
            {
                <div class="empty-detail">
                    <div class="empty-state">Select a conversation to view the question and model response.</div>
                </div>
            }
            else
            {
                <div class="detail-scroll"
                     @oncontextmenu="HandleDetailContextMenuAsync"
                     @oncontextmenu:preventDefault="true">
                    <section class="detail-section prompt-section">
                        <div class="section-label">
                            <span>USER QUESTION / TASK</span>
                            <span class="section-timestamp">@FormatTimestamp(SelectedConversation.CreatedAt)</span>
                        </div>
                        <div class="prompt-box">@SelectedConversation.Prompt</div>
                    </section>

                    <section class="detail-section response-section">
                        <div class="section-label">
                            <div class="section-label-left">
                                <span>MODEL RESPONSE</span>
                                <span class="response-context-hint">Select text &amp; right-click to comment</span>
                            </div>
                            @if (!string.IsNullOrEmpty(_feedbackStatusMessage))
                            {
                                <span class="feedback-status-pill">@_feedbackStatusMessage</span>
                            }
                        </div>
                        <div class="markdown-body" @key="SelectedConversation.Id">
                            @((MarkupString)RenderMarkdown(SelectedConversation.ResponseMd))
                        </div>
                    </section>
                </div>
            }

            @if (_isFeedbackOpen && (_isGitCompareOpen || SelectedConversation is not null))
            {
                    <div class="word-comment-backdrop" @onclick="CloseFeedbackCard">
                        <div class="word-comment-card"
                             style="top: @(_feedbackTopPx)px;"
                             role="dialog"
                             aria-label="Feedback Comment"
                             @onclick:stopPropagation="true"
                             @oncontextmenu:stopPropagation="true">
                            <div class="word-comment-accent"></div>
                            <div class="word-comment-content">
                                <div class="word-comment-header">
                                    <div class="word-comment-author">
                                        <span class="word-comment-avatar">F</span>
                                        <div class="word-comment-author-meta">
                                            <span class="word-comment-author-name">Feedback to OMP</span>
                                            <span class="word-comment-timestamp">Just now</span>
                                        </div>
                                    </div>
                                    <button type="button"
                                            class="word-comment-close"
                                            title="Discard comment"
                                            aria-label="Close comment"
                                            @onclick="CloseFeedbackCard">×</button>
                                </div>

                                @if (!IsSelectedSessionActive)
                                {
                                    <div class="word-comment-warning" role="alert">
                                        <strong>Warning:</strong> This session is not the active OMP session.
                                        @if (ActiveSessionInRepo is not null)
                                        {
                                            <span>The active session is <strong>@ActiveSessionInRepo.Name</strong>.</span>
                                        }
                                        else
                                        {
                                            <span>No active OMP session detected for this repo.</span>
                                        }
                                    </div>
                                }

                                @if (!string.IsNullOrWhiteSpace(_feedbackQuotedText))
                                {
                                    <div class="word-comment-quote">
                                        <div class="word-comment-quote-header">
                                            <span>Quoted from response</span>
                                            <button type="button"
                                                    class="word-comment-quote-clear"
                                                    title="Remove quote"
                                                    @onclick="ClearFeedbackQuote">×</button>
                                        </div>
                                        <blockquote>@_feedbackQuotedText</blockquote>
                                    </div>
                                }

                                <textarea id="word-comment-textarea"
                                          class="word-comment-textarea"
                                          rows="3"
                                          placeholder="Add a comment or reply to OMP… (Ctrl+Enter to send)"
                                          @bind="_feedbackComment"
                                          @bind:event="oninput"
                                          @onkeydown="HandleFeedbackKeyDown"></textarea>

                                <div class="word-comment-footer">
                                    <button type="button"
                                            class="word-comment-btn word-comment-btn-cancel"
                                            @onclick="CloseFeedbackCard">
                                        Cancel
                                    </button>
                                    <button type="button"
                                            class="word-comment-btn word-comment-btn-post"
                                            disabled="@string.IsNullOrWhiteSpace(_feedbackComment)"
                                            title="Post comment to OMP (Ctrl+Enter)"
                                            @onclick="SubmitFeedback">
                                        <span>Post</span>
                                        <svg viewBox="0 0 16 16" width="12" height="12" fill="currentColor" aria-hidden="true">
                                            <path d="M1.5 1.5L14.5 8L1.5 14.5L3.5 8L1.5 1.5ZM4.8 8.7L3.2 12.6L12.1 8L3.2 3.4L4.8 7.3H9.5V8.7H4.8Z" />
                                        </svg>
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
            }
        </main>
    </div>

    @if (_isFilterModalOpen)
    {
        <div class="filter-modal-backdrop" @onclick="CloseFilterModal">
            <div class="filter-modal-window" role="dialog" aria-modal="true" aria-label="Filter Conversations" @onclick:stopPropagation="true">
                <div class="filter-modal-header">
                    <span class="filter-modal-title">Filter Conversations</span>
                    <button type="button" class="filter-modal-close" aria-label="Close filter window" @onclick="CloseFilterModal">×</button>
                </div>
                <div class="filter-modal-body">
                    <label class="filter-input-label" for="conversation-filter-input">
                        Search term (matches question or model response)
                    </label>
                    <input id="conversation-filter-input"
                           type="text"
                           class="filter-input"
                           placeholder="Type search term…"
                           @bind="_filterDraft"
                           @bind:event="oninput"
                           @onkeydown="HandleFilterKeyDown"
                           autofocus />
                </div>
                <div class="filter-modal-footer">
                    @if (HasActiveFilter)
                    {
                        <button type="button" class="filter-btn filter-btn-secondary" @onclick="ClearFilterFromModal">
                            Clear Filter
                        </button>
                    }
                    <button type="button" class="filter-btn filter-btn-secondary" @onclick="CloseFilterModal">
                        Cancel
                    </button>
                    <button type="button" class="filter-btn filter-btn-primary" @onclick="ApplyFilter">
                        Apply Filter
                    </button>
                </div>
            </div>
        </div>
    }

    @if (_sessionToDelete is not null)
    {
        <div class="filter-modal-backdrop" @onclick="CancelDeleteSession">
            <div class="filter-modal-window" role="dialog" aria-modal="true" aria-label="Delete Session Confirmation" @onclick:stopPropagation="true">
                <div class="filter-modal-header">
                    <span class="filter-modal-title">Delete Session</span>
                    <button type="button" class="filter-modal-close" aria-label="Close delete confirmation" @onclick="CancelDeleteSession">×</button>
                </div>
                <div class="filter-modal-body">
                    <div class="delete-confirm-text">
                        Are you sure you want to delete <strong>@_sessionToDelete.Name</strong> and all @_sessionToDelete.ConversationCount of its @(_sessionToDelete.ConversationCount == 1 ? "conversation" : "conversations")?
                    </div>
                    <div class="delete-confirm-subtext">
                        Session ID: <code>@_sessionToDelete.SessionId</code>
                    </div>
                </div>
                <div class="filter-modal-footer">
                    <button type="button" class="filter-btn filter-btn-secondary" @onclick="CancelDeleteSession">
                        Cancel
                    </button>
                    <button type="button" class="filter-btn filter-btn-danger" @onclick="ConfirmDeleteSession">
                        Delete
                    </button>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private sealed record IndexedConversation(int TurnNumber, ConversationRecord Record);

    private static readonly MarkdownPipeline Pipeline = new MarkdownPipelineBuilder()
        .UseAdvancedExtensions()
        .Build();

    private IReadOnlyList<RepoSummary> _repos = [];
    private IReadOnlyList<SessionRecord> _sessions = [];
    private IReadOnlyList<ConversationRecord> _conversations = [];

    private string? _selectedRepo;
    private string? _selectedSessionId;
    private long? _selectedConversationId;

    private bool _isFilterModalOpen;
    private string _filterDraft = string.Empty;
    private string _appliedFilter = string.Empty;

    private bool _isSettingsOpen;
    private bool _autoSelectNewConversation = true;
    private ConversationAddedEvent? _pendingAutoSelect;
    private SessionRecord? _sessionToDelete;
    private bool _isPanesPinned = true;

    private bool _isFeedbackOpen;
    private string _feedbackComment = string.Empty;
    private string? _feedbackQuotedText;
    private int _feedbackTopPx = 140;
    private string? _feedbackStatusMessage;
    private System.Threading.Timer? _activeStatusTimer;
    private bool _isGitCompareOpen;
    private string _gitCompareMode = "latest";
    private string _gitOutputFormat = "line-by-line";
    private string _gitBaseRef = "HEAD~1";
    private string _gitTargetRef = "HEAD";
    private string _gitFileFilter = string.Empty;
    private GitRepoOverview? _gitOverview;
    private GitDiffResult? _gitDiffResult;
    private bool _gitDiffNeedsRender;


    private bool IsSelectedSessionActive => SessionTracker.IsSessionActive(_selectedSessionId);

    private SessionRecord? ActiveSessionInRepo =>
        _sessions.FirstOrDefault(s => SessionTracker.IsSessionActive(s.SessionId));
    private bool HasActiveFilter => !string.IsNullOrWhiteSpace(_appliedFilter);

    private IReadOnlyList<IndexedConversation> FilteredConversations
    {
        get
        {
            var list = new List<IndexedConversation>(_conversations.Count);
            var term = _appliedFilter.Trim();
            var hasFilter = term.Length > 0;

            for (var i = 0; i < _conversations.Count; i++)
            {
                var c = _conversations[i];
                if (!hasFilter
                    || (c.Prompt?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false)
                    || (c.ResponseMd?.Contains(term, StringComparison.OrdinalIgnoreCase) ?? false))
                {
                    list.Add(new IndexedConversation(i + 1, c));
                }
            }

            return list;
        }
    }

    private ConversationRecord? SelectedConversation =>
        _selectedConversationId.HasValue
            ? FilteredConversations.Select(x => x.Record).FirstOrDefault(c => c.Id == _selectedConversationId.Value)
            : null;

    protected override void OnInitialized()
    {
        Notifier.OnConversationAdded += HandleConversationAdded;
        Notifier.OnChanged += HandleHistoryChanged;
        RefreshState();
        _activeStatusTimer = new System.Threading.Timer(_ =>
        {
            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(3), TimeSpan.FromSeconds(3));
    }

    private void HandleConversationAdded(ConversationAddedEvent evt)
    {
        _ = InvokeAsync(() =>
        {
            if (_autoSelectNewConversation)
            {
                _pendingAutoSelect = evt;
            }
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_isGitCompareOpen && _gitDiffNeedsRender)
        {
            _gitDiffNeedsRender = false;
            try
            {
                await JS.InvokeVoidAsync(
                    "ompHistoryRenderGitDiff",
                    "omp-git-diff-container",
                    _gitDiffResult?.RawDiff ?? string.Empty,
                    _gitOutputFormat,
                    true);
            }
            catch
            {
                // Ignore transient JS interop disconnects
            }
        }
        else if (!_isGitCompareOpen && SelectedConversation is not null)
        {
            try
            {
                await JS.InvokeVoidAsync("ompHistoryRenderMermaid");
            }
            catch
            {
                // Ignore transient JS interop disconnects
            }
        }
    }

    private void HandleHistoryChanged()
    {
        _ = InvokeAsync(() =>
        {
            RefreshState();
            StateHasChanged();
        });
    }

    private void RefreshState()
    {
        var pending = _pendingAutoSelect;
        _pendingAutoSelect = null;

        _repos = Repository.GetRepos();

        if (_repos.Count == 0)
        {
            _selectedRepo = null;
            _sessions = [];
            _selectedSessionId = null;
            _conversations = [];
            _selectedConversationId = null;
            return;
        }

        if (pending is not null && _autoSelectNewConversation)
        {
            if (_repos.Any(r => string.Equals(r.Repo, pending.Repo, StringComparison.Ordinal)))
            {
                _selectedRepo = pending.Repo;
            }
            _selectedSessionId = pending.SessionId;
            _selectedConversationId = pending.ConversationId;
        }
        else if (string.IsNullOrEmpty(_selectedRepo) || !_repos.Any(r => string.Equals(r.Repo, _selectedRepo, StringComparison.Ordinal)))
        {
            _selectedRepo = _repos[0].Repo;
        }

        LoadSessionsForSelectedRepo(preserveSessionSelection: true);
    }

    private void SelectRepo(string repo)
    {
        if (string.Equals(_selectedRepo, repo, StringComparison.Ordinal))
        {
            return;
        }

        _selectedRepo = repo;
        _selectedSessionId = null;
        _selectedConversationId = null;
        LoadSessionsForSelectedRepo(preserveSessionSelection: false);
        if (_isGitCompareOpen)
        {
            LoadGitOverviewAndDiff(resetMode: true);
        }
    }

    private void LoadSessionsForSelectedRepo(bool preserveSessionSelection)
    {
        if (string.IsNullOrEmpty(_selectedRepo))
        {
            _sessions = [];
            _selectedSessionId = null;
            _conversations = [];
            _selectedConversationId = null;
            return;
        }

        _sessions = Repository.GetSessionsByRepo(_selectedRepo);

        if (_sessions.Count == 0)
        {
            _selectedSessionId = null;
            _conversations = [];
            _selectedConversationId = null;
            return;
        }

        var sessionStillExists = preserveSessionSelection
            && !string.IsNullOrEmpty(_selectedSessionId)
            && _sessions.Any(s => string.Equals(s.SessionId, _selectedSessionId, StringComparison.Ordinal));

        if (!sessionStillExists)
        {
            _selectedSessionId = _sessions[0].SessionId;
            LoadConversationsForSelectedSession(selectFirst: true);
        }
        else
        {
            LoadConversationsForSelectedSession(selectFirst: false);
        }
    }

    private void SelectSession(string sessionId)
    {
        _selectedSessionId = sessionId;
        LoadConversationsForSelectedSession(selectFirst: true);
    }

    private void LoadConversationsForSelectedSession(bool selectFirst)
    {
        if (string.IsNullOrEmpty(_selectedSessionId))
        {
            _conversations = [];
            _selectedConversationId = null;
            return;
        }

        _conversations = Repository.GetConversations(_selectedSessionId);
        EnsureValidFilteredSelection(selectFirst);
    }

    private void EnsureValidFilteredSelection(bool selectFirst)
    {
        var visible = FilteredConversations;
        if (visible.Count == 0)
        {
            _selectedConversationId = null;
            return;
        }

        if (selectFirst || !_selectedConversationId.HasValue || !visible.Any(c => c.Record.Id == _selectedConversationId.Value))
        {
            _selectedConversationId = visible[0].Record.Id;
        }
    }

    private void SelectConversation(long conversationId)
    {
        _selectedConversationId = conversationId;
        _isGitCompareOpen = false;
    }

    private void ToggleSettings()
    {
        _isSettingsOpen = !_isSettingsOpen;
    }

    private void OpenFilterModal()
    {
        _filterDraft = _appliedFilter;
        _isFilterModalOpen = true;
    }

    private void CloseFilterModal()
    {
        _isFilterModalOpen = false;
    }

    private void TogglePanesPinned()
    {
        _isPanesPinned = !_isPanesPinned;
    }

    private void ToggleGitCompare()
    {
        _isGitCompareOpen = !_isGitCompareOpen;
        if (_isGitCompareOpen)
        {
            LoadGitOverviewAndDiff(resetMode: true);
        }
    }

    private void CloseGitCompare()
    {
        _isGitCompareOpen = false;
    }

    private void RefreshGitCompare()
    {
        LoadGitOverviewAndDiff(resetMode: false);
    }

    private void LoadGitOverviewAndDiff(bool resetMode)
    {
        if (string.IsNullOrEmpty(_selectedRepo))
        {
            _gitOverview = null;
            _gitDiffResult = null;
            return;
        }

        var repoSummary = _repos.FirstOrDefault(r => string.Equals(r.Repo, _selectedRepo, StringComparison.Ordinal));
        _gitOverview = GitCompare.GetRepoOverview(_selectedRepo, repoSummary?.RepoPath);

        if (resetMode && _gitOverview.IsAvailable)
        {
            if (_gitOverview.UncommittedFileCount > 0)
            {
                _gitCompareMode = "working";
            }
            else
            {
                _gitCompareMode = "latest";
            }

            if (_gitOverview.RecentCommits.Count > 0)
            {
                _gitTargetRef = _gitOverview.RecentCommits[0].ShortHash;
                _gitBaseRef = _gitOverview.RecentCommits.Count > 1
                    ? _gitOverview.RecentCommits[1].ShortHash
                    : _gitOverview.RecentCommits[0].ShortHash;
            }
        }

        RunGitDiff();
    }

    private void SelectGitMode(string mode)
    {
        _gitCompareMode = mode;
        if (mode == "latest" && _gitOverview?.RecentCommits.Count > 0)
        {
            if (string.IsNullOrWhiteSpace(_gitTargetRef) || _gitTargetRef == "HEAD" || _gitTargetRef == "WORKING")
            {
                _gitTargetRef = _gitOverview.RecentCommits[0].ShortHash;
            }
        }
        else if (mode == "compare" && _gitOverview?.RecentCommits.Count > 0)
        {
            if (string.IsNullOrWhiteSpace(_gitBaseRef))
            {
                _gitBaseRef = _gitOverview.RecentCommits.Count > 1
                    ? _gitOverview.RecentCommits[1].ShortHash
                    : _gitOverview.RecentCommits[0].ShortHash;
            }
            if (string.IsNullOrWhiteSpace(_gitTargetRef))
            {
                _gitTargetRef = "HEAD";
            }
        }
        RunGitDiff();
    }

    private void SetGitOutputFormat(string format)
    {
        _gitOutputFormat = format;
        _gitDiffNeedsRender = true;
    }

    private void OnGitSingleCommitChanged(ChangeEventArgs e)
    {
        _gitTargetRef = e.Value?.ToString() ?? "HEAD";
        RunGitDiff();
    }

    private void OnGitBaseRefChanged(ChangeEventArgs e)
    {
        _gitBaseRef = e.Value?.ToString() ?? "HEAD~1";
        RunGitDiff();
    }

    private void OnGitTargetRefChanged(ChangeEventArgs e)
    {
        _gitTargetRef = e.Value?.ToString() ?? "HEAD";
        RunGitDiff();
    }

    private void HandleGitFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            RunGitDiff();
        }
        else if (e.Key == "Escape" && !string.IsNullOrEmpty(_gitFileFilter))
        {
            ClearGitFileFilter();
        }
    }

    private void ClearGitFileFilter()
    {
        _gitFileFilter = string.Empty;
        RunGitDiff();
    }

    private void ToggleGitFileChip(string filePath)
    {
        if (string.Equals(_gitFileFilter?.Trim(), filePath, StringComparison.Ordinal))
        {
            _gitFileFilter = string.Empty;
        }
        else
        {
            _gitFileFilter = filePath;
        }
        RunGitDiff();
    }

    private void RunGitDiff()
    {
        if (string.IsNullOrEmpty(_selectedRepo) || _gitOverview?.IsAvailable != true)
        {
            _gitDiffResult = null;
            return;
        }

        _gitDiffResult = GitCompare.GetDiff(
            _selectedRepo,
            _gitCompareMode,
            _gitBaseRef,
            _gitTargetRef,
            _gitFileFilter,
            _gitOverview.RepoPath);
        _gitDiffNeedsRender = true;
    }

    private void ApplyFilter()
    {
        _appliedFilter = _filterDraft.Trim();
        _isFilterModalOpen = false;
        EnsureValidFilteredSelection(selectFirst: true);
    }

    private void ClearFilter()
    {
        _appliedFilter = string.Empty;
        _filterDraft = string.Empty;
        EnsureValidFilteredSelection(selectFirst: false);
    }

    private void ClearFilterFromModal()
    {
        _appliedFilter = string.Empty;
        _filterDraft = string.Empty;
        _isFilterModalOpen = false;
        EnsureValidFilteredSelection(selectFirst: false);
    }

    private void HandleFilterKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            ApplyFilter();
        }
        else if (e.Key == "Escape")
        {
            CloseFilterModal();
        }
    }

    private async Task HandleDetailContextMenuAsync(MouseEventArgs e)
    {
        if ((!_isGitCompareOpen && SelectedConversation is null) || string.IsNullOrEmpty(_selectedSessionId))
        {
            return;
        }

        string selectedText = string.Empty;
        try
        {
            selectedText = await JS.InvokeAsync<string>("ompHistoryCaptureSelection");
        }
        catch
        {
            // ignore JS interop failures
        }

        _feedbackQuotedText = string.IsNullOrWhiteSpace(selectedText) ? null : selectedText.Trim();
        _feedbackTopPx = (int)Math.Clamp(e.ClientY - 24, 68, 520);
        _isFeedbackOpen = true;
        _feedbackStatusMessage = null;
    }

    private void ClearFeedbackQuote()
    {
        _feedbackQuotedText = null;
    }

    private void CloseFeedbackCard()
    {
        _isFeedbackOpen = false;
        _feedbackComment = string.Empty;
        _feedbackQuotedText = null;
    }

    private void HandleFeedbackKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && (e.CtrlKey || e.MetaKey))
        {
            SubmitFeedback();
        }
        else if (e.Key == "Escape")
        {
            CloseFeedbackCard();
        }
    }

    private void SubmitFeedback()
    {
        if (string.IsNullOrWhiteSpace(_selectedSessionId) || string.IsNullOrWhiteSpace(_feedbackComment))
        {
            return;
        }

        var isActive = IsSelectedSessionActive;
        SessionTracker.EnqueueFeedback(
            _selectedSessionId,
            _feedbackComment,
            _feedbackQuotedText,
            SelectedConversation?.Id);

        _isFeedbackOpen = false;
        _feedbackComment = string.Empty;
        _feedbackQuotedText = null;
        _feedbackStatusMessage = isActive
            ? "Feedback sent to active OMP session"
            : "Feedback queued (will deliver when session becomes active)";
    }

    private void RequestDeleteSession(SessionRecord session)
    {
        _sessionToDelete = session;
    }

    private void CancelDeleteSession()
    {
        _sessionToDelete = null;
    }

    private void ConfirmDeleteSession()
    {
        if (_sessionToDelete is null)
        {
            return;
        }

        var sessionId = _sessionToDelete.SessionId;
        _sessionToDelete = null;

        var wasSelected = string.Equals(_selectedSessionId, sessionId, StringComparison.Ordinal);
        if (wasSelected)
        {
            _selectedSessionId = null;
            _selectedConversationId = null;
        }
        Repository.DeleteSession(sessionId);
    }

    private static string RenderMarkdown(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown))
        {
            return "<em>(Empty response)</em>";
        }
        return Markdown.ToHtml(markdown, Pipeline);
    }

    private static string TruncatePreview(string? text, int maxLength)
    {
        if (string.IsNullOrWhiteSpace(text))
        {
            return "(empty)";
        }

        var singleLine = string.Join(" ", text.Split(['\r', '\n'], StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries));
        return singleLine.Length <= maxLength ? singleLine : singleLine[..maxLength] + "…";
    }

    private static string FormatTimestamp(string iso)
    {
        if (DateTimeOffset.TryParse(iso, out var dto))
        {
            var local = dto.ToLocalTime();
            if (local.Date == DateTimeOffset.Now.Date)
            {
                return local.ToString("HH:mm:ss");
            }
            return local.ToString("yyyy-MM-dd HH:mm");
        }
        return iso;
    }

    private static string FormatFullDateTime(string iso)
    {
        if (DateTimeOffset.TryParse(iso, out var dto))
        {
            return dto.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss");
        }
        return iso;
    }

    public void Dispose()
    {
        Notifier.OnConversationAdded -= HandleConversationAdded;
        Notifier.OnChanged -= HandleHistoryChanged;
        _activeStatusTimer?.Dispose();
    }
}
