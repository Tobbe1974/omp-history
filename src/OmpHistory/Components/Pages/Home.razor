    private void InitializeTurnComparisonRefs(ConversationRecord? preferredTurn)
    {
        var snaps = ConversationsWithSnapshots;
        if (snaps.Count == 0)
        {
            return;
        }

        var targetTurn = preferredTurn is not null
            ? snaps.FirstOrDefault(s => s.Record.Id == preferredTurn.Id)?.Record ?? snaps[^1].Record
            : snaps[^1].Record;

        if (!string.IsNullOrWhiteSpace(targetTurn.GitTreeBefore) && !string.IsNullOrWhiteSpace(targetTurn.GitTreeAfter))
        {
            _gitBaseRef = targetTurn.GitTreeBefore;
            _gitTargetRef = targetTurn.GitTreeAfter;
            return;
        }

        var firstTree = snaps[0].Record.GitTreeBefore ?? snaps[0].Record.GitTreeAfter ?? "HEAD";
        var lastTree = snaps[^1].Record.GitTreeAfter ?? snaps[^1].Record.GitTreeBefore ?? "WORKING";
        _gitBaseRef = firstTree;
        _gitTargetRef = lastTree;
    }

